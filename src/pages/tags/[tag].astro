---
import BlogArchiveList from "../../components/BlogArchiveList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisiblePosts } from "../../lib/posts";

const allPosts = await getVisiblePosts();

export async function getStaticPaths() {
  const allPosts = await getVisiblePosts();

  const tags = new Set<string>();
  for (const post of allPosts) {
    for (const tag of post.data.tags ?? []) tags.add(tag);
  }

  return Array.from(tags).map((tag) => ({
    params: { tag: encodeURIComponent(tag) },
    props: { tag },
  }));
}

const { tag } = Astro.props as { tag: string };
const posts = allPosts.filter((post) => (post.data.tags ?? []).includes(tag));
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged "${tag}".`}>
  <section class="prose">
    <p class="muted"><a href="/tags">&larr; All tags</a></p>

    <h1>Tag: {tag}</h1>

    {posts.length === 0 ? (
      <p class="muted">No posts for this tag yet.</p>
    ) : (
      <BlogArchiveList posts={posts} showDescriptions={false} />
    )}
  </section>
</BaseLayout>
