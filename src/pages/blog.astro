---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Draft handling:
// - In dev: show everything
// - In prod: hide draft posts
const posts = (await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Writing, notes, and research updates.">
  <h1>Blog</h1>

  {posts.length === 0 ? (
    <p class="muted">No posts yet. Check back soon.</p>
  ) : (
    <ol class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>

          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>

            <span class="tags">
              {post.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </span>

            {post.data.draft ? <span class="pill">Draft</span> : null}
          </div>
        </li>
      ))}
    </ol>
  )}

  <p class="rss-link"><a href="/rss.xml">RSS</a></p>

  <style>
    .post-list { list-style: none; padding: 0; margin: 1rem 0; }
    .post-item { padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.08); }
    .post-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; font-size: 0.95rem; }
    .tags { display: inline-flex; gap: 0.35rem; flex-wrap: wrap; }
    .tag { padding: 0.1rem 0.45rem; border: 1px solid rgba(0,0,0,0.15); border-radius: 999px; }
    .pill { padding: 0.1rem 0.5rem; border-radius: 999px; border: 1px solid rgba(0,0,0,0.25); }
    .rss-link { margin-top: 1rem; }
  </style>
</BaseLayout>
