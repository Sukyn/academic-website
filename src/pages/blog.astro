---
import BlogArchiveList from "../components/BlogArchiveList.astro";
import BlogPagination from "../components/BlogPagination.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getPageCount,
  getPostsForPage,
  getVisiblePosts,
} from "../lib/posts";

const allPosts = await getVisiblePosts();
const pageCount = getPageCount(allPosts.length);
const posts = getPostsForPage(allPosts, 1);
---

<BaseLayout
  title="Blog"
  description="Expository posts and research notes on quantum circuits, qudits, and nearby mathematics."
>
  <section class="prose">
    <h1>Blog</h1>

    <p class="lead">
      These posts are where I try to make circuit algebra feel more legible:
      sometimes by explaining a core idea gently, sometimes by writing down the
      structural viewpoint I wish I had found earlier.
    </p>

    {allPosts.length === 0 ? (
      <p class="muted">No posts yet. Check back soon.</p>
    ) : (
      <>
        <h2>Archive</h2>
        <BlogArchiveList posts={posts} />
        <BlogPagination currentPage={1} pageCount={pageCount} />
      </>
    )}

    <p class="rss-link"><a href="/rss.xml">RSS feed</a></p>
  </section>

  <style>
    .lead {
      font-size: 1.05rem;
    }

    .rss-link {
      margin-top: 1.25rem;
    }
  </style>
</BaseLayout>
