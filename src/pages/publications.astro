---
import { publicationNotesById } from "../data/publicationNotes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { parseBibtexToPubs } from "../lib/bibtex";

import bibtex from "../content/publications.bibtex?raw";

const pubs = parseBibtexToPubs(bibtex);

function publicationLinks(url?: string) {
  if (!url) return [];

  try {
    const parsed = new URL(url);

    if (parsed.hostname.includes("arxiv.org")) {
      const match = parsed.pathname.match(/\/abs\/(.+)$/);
      const pdfPath = match ? `https://arxiv.org/pdf/${match[1]}.pdf` : undefined;

      return [
        { label: "arXiv", href: url },
        ...(pdfPath ? [{ label: "PDF", href: pdfPath }] : []),
      ];
    }

    if (parsed.hostname.includes("doi.org")) {
      return [{ label: "DOI", href: url }];
    }
  } catch {
    return [{ label: "Open", href: url }];
  }

  return [{ label: "Open", href: url }];
}

const pubsWithLinks = pubs.map((pub) => ({
  ...pub,
  links: publicationLinks(pub.url),
  note: publicationNotesById[pub.id],
}));
---

<BaseLayout
  title="Publications"
  description="Selected papers and preprints on quantum circuits, qudits, and equational theories."
>
  <section class="prose publications-page">
    <h1>Publications</h1>

    {pubsWithLinks.length === 0 ? (
      <p class="muted">No publications yet.</p>
    ) : (
      <ol class="pub-list">
        {pubsWithLinks.map((publication) => (
          <li id={publication.id} class="pub-item">
            <p class="pub-title">
              <strong>{publication.title}</strong>
            </p>
            {publication.authors ? <p class="muted">{publication.authors}</p> : null}
            {publication.note?.status || publication.venue || publication.year ? (
              <p class="pub-meta">
                {[publication.note?.status, publication.venue, publication.year]
                  .filter(Boolean)
                  .join(" | ")}
              </p>
            ) : null}
            {publication.note?.summary ? (
              <p class="pub-summary">{publication.note.summary}</p>
            ) : null}
            {publication.links.length > 0 ? (
              <p class="pub-links">
                {publication.links.map((link, index) => (
                  <>
                    {index > 0 ? <span aria-hidden="true"> | </span> : null}
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  </>
                ))}
              </p>
            ) : null}
          </li>
        ))}
      </ol>
    )}

    <p class="muted">
      If you want slides or other supplementary material around these papers,
      feel free to <a href="/contact">email me</a>.
    </p>
  </section>

  <style>
    .publications-page {
      max-width: 48rem;
    }

    .pub-list {
      padding-left: 1.25rem;
      margin: 1.5rem 0;
    }

    .pub-item {
      margin-bottom: 1.5rem;
    }

    .pub-title {
      margin-bottom: 0.4rem;
    }

    .pub-summary {
      margin-bottom: 0.5rem;
    }

    .pub-meta,
    .pub-links {
      font-size: 0.95rem;
      color: var(--color-muted);
    }
  </style>
</BaseLayout>
