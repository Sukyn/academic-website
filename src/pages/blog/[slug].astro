---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

// Build one page per post (static output)
export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description ?? "Blog post."}>
  <article class="article prose">
    <header class="header">
      <h1>{post.data.title}</h1>

      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>

        <span class="tags">
          {post.data.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </span>

        {post.data.draft ? <span class="pill draft">Draft</span> : null}
      </div>
    </header>

    <Content />

    <footer class="footer">
      <a href="/blog">← Back to Blog</a>
    </footer>
  </article>

  <style>
    /* Keep only layout-specific tweaks here (global.css does the real styling) */
    .header { margin-bottom: 1.25rem; }
    .tags { display: inline-flex; gap: 0.35rem; flex-wrap: wrap; }
    .footer { margin-top: 2rem; }
  </style>
</BaseLayout>
