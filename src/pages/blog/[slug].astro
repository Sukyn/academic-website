---
import TableOfContents from "../../components/TableOfContents.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Build one page per post (static output)
export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Related posts (by shared tags)
const allPosts = (await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
}))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// score by number of shared tags
function sharedTagScore(a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) {
  const set = new Set(a.data.tags ?? []);
  let score = 0;
  for (const t of b.data.tags ?? []) if (set.has(t)) score++;
  return score;
}

const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ post: p, score: sharedTagScore(post, p) }))
  .filter(({ score }) => score > 0)
  .sort((x, y) => y.score - x.score || y.post.data.date.valueOf() - x.post.data.date.valueOf())
  .slice(0, 3)
  .map(({ post }) => post);


const WORDS_PER_MINUTE = 200;

function readingTimeFromText(text) {
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(words / WORDS_PER_MINUTE));
  return `(${minutes} min read)`;
}
---

<script
  src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"
  defer
></script>

<script>
  function mermaidTheme() {
    return document.documentElement.dataset.theme === "dark"
      ? "dark"
      : "default";
  }

  function renderMermaid() {
    const mermaidAPI = window.mermaid;
    if (!mermaidAPI) return;

    const blocks = Array.from(
      document.querySelectorAll("pre > code.language-mermaid")
    );

    if (blocks.length === 0) return;

    mermaidAPI.initialize({
      startOnLoad: false,
      theme: mermaidTheme(),
      securityLevel: "strict",
    });

    for (const codeEl of blocks) {
      const pre = codeEl.parentElement;
      if (!pre || pre.dataset.mermaidRendered === "true") continue;

      const source = codeEl.textContent ?? "";

      const container = document.createElement("div");
      container.className = "mermaid";
      container.dataset.source = source;
      container.textContent = source;

      pre.replaceWith(container);
      pre.dataset.mermaidRendered = "true";
    }

    mermaidAPI.run({ querySelector: ".mermaid" });
  }

  // Initial load (after DOM + CDN script)
  document.addEventListener("DOMContentLoaded", renderMermaid);

  // Astro client-side navigation
  document.addEventListener("astro:page-load", renderMermaid);

  // Re-render on theme change
  const obs = new MutationObserver(() => {
    const nodes = document.querySelectorAll(".mermaid");
    for (const n of nodes) {
      n.innerHTML = "";
      n.textContent = n.dataset.source ?? "";
    }
    renderMermaid();
  });

  obs.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>



<BaseLayout
  title={post.data.title}
  description={post.data.description ?? "Blog post."}
  ogImage={post.data.coverImage ?? "/og/default.png"}
>
  <article class="article">
    <header class="header prose">
      <h1>{post.data.title}</h1>

      <div class="meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>

        <span class="reading-time">{readingTimeFromText(post.body)}</span>

        <span class="tags">
          {post.data.tags.map((t) => (
            <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
          ))}
        </span>

        {post.data.draft ? <span class="pill">Draft</span> : null}
      </div>
    </header>

    <div class="article-grid">
      <aside class="toc-col" aria-label="Table of contents">
        <TableOfContents headings={headings} />
      </aside>

      <div class="content-col prose">
        {post.data.coverImage ? (
          <figure class="cover">
            <img
              src={post.data.coverImage}
              alt={post.data.coverImageAlt ?? `${post.data.title} cover image`}
              loading="eager"
              decoding="async"
            />
            {post.data.coverCaption ? (
              <figcaption class="cover-caption">{post.data.coverCaption}</figcaption>
            ) : null}
          </figure>
        ) : null}

                <Content />

        {related.length > 0 ? (
          <section class="related">
            <h2>Related posts</h2>
            <ol class="related-list">
              {related.map((p) => (
                <li class="related-item">
                  <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                  <div class="post-meta">
                    <time datetime={p.data.date.toISOString()}>
                      {p.data.date.toISOString().slice(0, 10)}
                    </time>
                    {p.data.description ? (
                      <span class="muted"> — {p.data.description}</span>
                    ) : null}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        <footer class="footer">
          <a href="/blog">← Back to Blog</a>
        </footer>

      </div>
    </div>
  </article>

  <style>
    /* -------------------------
       Small page-specific spacing
       ------------------------- */
    .header {
      margin-bottom: 0.5rem; /* ↓ was 1.25rem */
    }

    .tags {
      display: inline-flex;
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    .footer {
      margin-top: 2rem;
    }

    /* Base: 1 column layout (mobile + default) */
    .article-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem; /* ↓ was 1.25rem */
    }

    /* Mobile: TOC goes above content */
    @media (max-width: 979px) {
      .toc-col {
        order: -1;
      }
    }

    /* Desktop behavior */
    @media (min-width: 980px) {
      /* Make blog posts use a wider container */
      :global(main.container) {
        width: min(100%, 1400px);
      }

      /* Default: TOC OPEN => two columns */
      .article-grid {
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 1.5rem; /* ↓ was 2.25rem */
        align-items: start;
      }

      /* Sticky TOC column */
      .toc-col {
        position: sticky;
        top: 0.75rem;
        max-height: calc(100vh - 6rem);
        overflow: auto;

        display: flex;
        justify-content: flex-start; /* feels less "floaty" */
      }

      /* Content width in the 2-col layout */
      .content-col.prose {
        max-width: 110ch;
        margin-inline: 0; /* don't auto-center inside grid */
        width: 100%;
      }

      /* -------------------------
         TOC CLOSED => single column
         ------------------------- */
      .article-grid:has(.toc:not([open])) {
        grid-template-columns: 1fr;
        gap: 0rem;
      }

      /* Center content again when single column */
      .article-grid:has(.toc:not([open])) .content-col.prose {
        margin-inline: auto;
      }

      /* Place the "Table of contents" pill near the content, not floating */
      .article-grid:has(.toc:not([open])) .toc-col {
        justify-content: center; /* centered above content */
        position: static;        /* no sticky needed when closed */
        max-height: none;
        overflow: visible;
      }


    }

    .related {
  margin-top: 2.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--color-border);
}

.related-list {
  list-style: none;
  padding: 0;
  margin: 0.75rem 0 0;
}

.related-item {
  padding: 0.75rem 0;
  border-top: 1px solid var(--color-border);
}

.related-item:first-child {
  border-top: none;
  padding-top: 0;
}

  </style>
</BaseLayout>
