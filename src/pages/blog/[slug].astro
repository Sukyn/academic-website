---
import TableOfContents from "../../components/TableOfContents.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Giscus from "../../components/Giscus.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Build one page per post (static output)
export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Safeguards
const tags = post.data.tags ?? [];
const hasToc = headings?.length > 0;

// Related posts (by shared tags)
const allPosts = (await getCollection("posts", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// score by number of shared tags
function sharedTagScore(
  a: CollectionEntry<"posts">,
  b: CollectionEntry<"posts">
) {
  const set = new Set(a.data.tags ?? []);
  let score = 0;
  for (const t of b.data.tags ?? []) if (set.has(t)) score++;
  return score;
}

const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ post: p, score: sharedTagScore(post, p) }))
  .filter(({ score }) => score > 0)
  .sort(
    (x, y) =>
      y.score - x.score ||
      y.post.data.date.valueOf() - x.post.data.date.valueOf()
  )
  .slice(0, 3)
  .map(({ post }) => post);

const WORDS_PER_MINUTE = 200;

function readingTimeFromText(text: string) {
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  const minutes = Math.max(1, Math.ceil(words / WORDS_PER_MINUTE));
  return `(${minutes} min read)`;
}

// Load Mermaid only if the post actually contains a mermaid fence
const hasMermaid =
  /```mermaid\b/.test(post.body) || post.body.includes("language-mermaid");
---

{hasMermaid ? (
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js" defer></script>
) : null}

{hasMermaid ? (
  <script>
    (() => {
      // TS-safe access to Mermaid on the global object
      const getMermaid = () => (globalThis as any).mermaid as any | undefined;

      function mermaidTheme() {
        return document.documentElement.dataset.theme === "dark"
          ? "dark"
          : "default";
      }

      // Convert fenced blocks into <div class="mermaid"> containers (idempotent)
      function ensureMermaidContainers() {
        const blocks = Array.from(
          document.querySelectorAll("pre > code.language-mermaid")
        );

        for (const codeEl of blocks) {
          const pre = codeEl.parentElement;
          if (!(pre instanceof HTMLElement)) continue;

          const source = codeEl.textContent ?? "";

          const container = document.createElement("div");
          container.className = "mermaid";
          container.dataset.source = source;
          container.textContent = source;

          pre.replaceWith(container);
        }
      }

      function renderMermaid() {
        const mermaidAPI = getMermaid();
        if (!mermaidAPI) return;

        ensureMermaidContainers();

        const nodes = Array.from(document.querySelectorAll(".mermaid"));
        if (nodes.length === 0) return;

        mermaidAPI.initialize({
          startOnLoad: false,
          theme: mermaidTheme(),
          securityLevel: "strict",
        });

        // Clear prior render (important for theme changes)
        for (const n of nodes) {
          if (!(n instanceof HTMLElement)) continue;
          n.removeAttribute("data-processed"); // Mermaid uses this internally
          n.innerHTML = "";
          n.textContent = n.dataset.source ?? "";
        }

        mermaidAPI.run({ querySelector: ".mermaid" });
      }

      // Initial load
      document.addEventListener("DOMContentLoaded", renderMermaid);
      // Astro client-side navigation
      document.addEventListener("astro:page-load", renderMermaid);

      // Re-render on theme change
      const obs = new MutationObserver(renderMermaid);
      obs.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    })();
  </script>
) : null}

<BaseLayout
  title={post.data.title}
  description={post.data.description ?? "Blog post."}
  ogImage={post.data.coverImage ?? "/og/default.png"}
>
  <article class="article">
    <header class="header prose">
      <h1>{post.data.title}</h1>

      <div class="meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>

        <span class="reading-time">{readingTimeFromText(post.body)}</span>

        {tags.length > 0 ? (
          <span class="tags" aria-label="Tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
            ))}
          </span>
        ) : null}

        {post.data.draft ? <span class="pill">Draft</span> : null}
      </div>
    </header>

    <div class={`article-grid ${hasToc ? "article-grid--with-toc" : ""}`}>
      {hasToc ? (
        <aside class="toc-col" aria-label="Table of contents">
          <TableOfContents headings={headings} />
        </aside>
      ) : null}

      <div class="content-col prose">
        {post.data.coverImage ? (
          <figure class="cover">
            <img
              src={post.data.coverImage}
              alt={post.data.coverImageAlt ?? `${post.data.title} cover image`}
              loading="eager"
              decoding="async"
            />
            {post.data.coverCaption ? (
              <figcaption class="cover-caption">{post.data.coverCaption}</figcaption>
            ) : null}
          </figure>
        ) : null}

        <Content />
        <Giscus />

        {related.length > 0 ? (
          <section class="related">
            <h2>Related posts</h2>
            <ol class="related-list">
              {related.map((p) => (
                <li class="related-item">
                  <a href={`/blog/${p.id}/`}>{p.data.title}</a>
                  <div class="post-meta">
                    <time datetime={p.data.date.toISOString()}>
                      {p.data.date.toISOString().slice(0, 10)}
                    </time>
                    {p.data.description ? (
                      <span class="muted"> — {p.data.description}</span>
                    ) : null}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        <footer class="footer">
          <a href="/blog">← Back to Blog</a>
        </footer>
      </div>
    </div>
  </article>

  <style>
    .header {
      margin-bottom: 0.5rem;
    }

    .tags {
      display: inline-flex;
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    .footer {
      margin-top: 2rem;
    }

    .article-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    @media (max-width: 979px) {
      .toc-col {
        order: -1;
      }
    }

    @media (min-width: 980px) {
      :global(main.container) {
        width: min(100%, 1400px);
      }

      .article-grid--with-toc {
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 1.5rem;
        align-items: start;
      }

      .article-grid--with-toc .toc-col {
        position: sticky;
        top: 0.75rem;
        max-height: calc(100vh - 6rem);
        overflow: auto;

        display: flex;
        justify-content: flex-start;
      }

      .article-grid--with-toc .content-col.prose {
        max-width: 110ch;
        margin-inline: 0;
        width: 100%;
      }

      .article-grid--with-toc:has(.toc:not([open])) {
        grid-template-columns: 1fr;
        gap: 0rem;
      }

      .article-grid--with-toc:has(.toc:not([open])) .content-col.prose {
        margin-inline: auto;
      }

      .article-grid--with-toc:has(.toc:not([open])) .toc-col {
        justify-content: center;
        position: static;
        max-height: none;
        overflow: visible;
      }
    }

    .related {
      margin-top: 2.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-border);
    }

    .related-list {
      list-style: none;
      padding: 0;
      margin: 0.75rem 0 0;
    }

    .related-item {
      padding: 0.75rem 0;
      border-top: 1px solid var(--color-border);
    }

    .related-item:first-child {
      border-top: none;
      padding-top: 0;
    }
  </style>
</BaseLayout>
