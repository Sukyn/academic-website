---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferDetailModal from "../components/OfferDetailModal.astro";
import OfferPreviewCard from "../components/OfferPreviewCard.astro";
import OfferSummaryBlock from "../components/OfferSummaryBlock.astro";
import { getCollection } from "astro:content";
import {
  offerSummaries,
  offerSummariesByTopic,
  type OfferSummary,
  type TopicKey,
} from "../data/offerSummaries";
import { renderInlineMath } from "../lib/inlineMath";

const refs = {
  quditCliffordArbitraryD: "https://arxiv.org/abs/quant-ph/0506065",
  quditCliffordIdeal: "https://arxiv.org/abs/1307.5087",
  cliffordReview: "https://arxiv.org/abs/1810.10259",
  transmonQuditSynthesis: "https://arxiv.org/abs/2212.04496",

  lofiCalculus: "https://arxiv.org/abs/2402.17693",

  chevaliersGame: "https://sukyn.itch.io/les-chevaliers-du-quantique",
  chevaliersArticle:
    "https://tice-education.fr/tous-les-articles-erun/1236-les-chevaliers-du-quantique",

  fewSquareRoots: "https://arxiv.org/abs/2310.14056",
  qutritCyclotomic: "https://arxiv.org/abs/2303.13644",
  singleQutritCliffordT: "https://arxiv.org/abs/1803.05047",
  singleQuditCliffordT: "https://arxiv.org/abs/2011.07970",
  multiQutritExactSynthesis: "https://arxiv.org/abs/2405.08136",

  quditCliffordAlgebras: "https://arxiv.org/abs/1809.07809",
  polycontrolledProps: "https://arxiv.org/abs/2602.09873",
  controlledProps: "https://arxiv.org/abs/2508.21756",
  graphicalAlgebraicGeometry: "https://arxiv.org/abs/2605.13993",

  circuitPresentations: "https://quantum-journal.org/papers/q-2022-06-13-734/",
  cnotDihedralPresentation: "https://arxiv.org/abs/1701.00140",
  cnotDihedralSynthesis: "https://arxiv.org/abs/2006.12042",

  phasePolynomialsQubit: "https://arxiv.org/abs/1303.2042",
  phasePolynomialsQudit: "https://arxiv.org/abs/1902.05634",
  qutritPhaseGadgets: "https://arxiv.org/abs/2204.13681",
  quditPhaseGadgetMethod: "https://arxiv.org/abs/2504.12710",
  primeAffineDiagonalFragments: "https://arxiv.org/abs/2603.06466",

  zxCompleteThesis: "https://arxiv.org/abs/2209.14894",
  zxCompleteFiniteDim: "https://arxiv.org/abs/2405.10896",
  qutritZXStabilizerComplete: "https://arxiv.org/abs/1803.00696",
  pyzx: "https://arxiv.org/abs/1904.04735",
  zxGraphSimplification: "https://arxiv.org/abs/1902.03178",
  zxExtractionHardness: "https://arxiv.org/abs/2202.09194",
  zhIntro: "https://arxiv.org/abs/1805.02175",
  quditZH: "https://arxiv.org/abs/2307.10095",

  multiControlledQudit: "https://arxiv.org/abs/2303.12979",
  quditsReview: "https://arxiv.org/abs/2008.00959",
  faultToleranceByConstruction: "https://arxiv.org/abs/2506.17181",
  quditFaultTolerance: "https://arxiv.org/abs/quant-ph/9802007",
  qsynthPaper: "https://arxiv.org/abs/2504.00634",
  depthOptimalCliffordSAT: "https://arxiv.org/abs/2305.01674",
  cnotSpaceDepthTradeoff: "https://arxiv.org/abs/1907.05087",
  ancillaCostTradeoff: "https://arxiv.org/abs/1405.6073",
};

type Topic = {
  key: TopicKey;
  title: string;
  description: string;
  status: string;
  statusClass: string;
  bestFor: string;
};

type OfferDetail = {
  question: string;
  why: string;
  firstSteps: string[];
  links?: Array<{ label: string; href: string }>;
};

const topics: Topic[] = [
  {
    key: "qudit-clifford",
    title: "Qudit Clifford structure",
    description:
      "Clifford circuits in prime, even, and composite dimension. The practical targets are conventions, normal forms, and rewrite rules that can actually be used.",
    status: "Current focus",
    statusClass: "pill--focus",
    bestFor: "advanced students or researchers who like both algebra and tooling",
  },
  {
    key: "linear-optics",
    title: "Linear optics",
    description:
      "Small constructive questions in LOv/LOfi, with Fourier gates as the main test case.",
    status: "Open / exploratory",
    statusClass: "pill--open",
    bestFor: "people who like explicit matrices and benchmarks",
  },
  {
    key: "outreach",
    title: "Outreach",
    description:
      "Playable or printable material that teaches a real circuit idea without pretending to be a full course.",
    status: "Actively looking for help",
    statusClass: "pill--open",
    bestFor: "collaborators who enjoy pedagogy, games, or web work",
  },
  {
    key: "algebraic-viewpoints",
    title: "Other algebraic viewpoints",
    description:
      "Exact synthesis, Clifford/geometric algebra, controlled structure, and group presentations. A viewpoint stays on the list only if it makes a circuit problem clearer.",
    status: "Tomorrow-problem",
    statusClass: "pill--incubating",
    bestFor: "self-directed people with strong algebra taste",
  },
  {
    key: "equational-theory",
    title: "Equational theories",
    description:
      "Generators, equations, normal forms, and the places where a calculus becomes small enough to reason with.",
    status: "Current focus",
    statusClass: "pill--focus",
    bestFor: "people who want theorem work with compiler consequences",
  },
  {
    key: "zx-zh",
    title: "ZX/ZH diagrams",
    description:
      "Extraction and rewrite tooling for qudit diagrammatic calculi. Lower priority for now.",
    status: "Backlog / parked",
    statusClass: "pill--parked",
    bestFor: "implementation-heavy collaborators",
  },
  {
    key: "circuit-fragments",
    title: "Circuit fragments",
    description:
      "Small gate sets, expressivity, fault-tolerance constraints, and quantitative tradeoffs.",
    status: "Current focus",
    statusClass: "pill--focus",
    bestFor: "people who like concrete fragments and measurements",
  },
];

const offerDetails: Record<string, OfferDetail> = {
  "offer-arbitrary-d-clifford": {
    question:
      "Can we write Clifford circuit equations for all $d$ without hiding composite dimensions under casework?",
    why:
      "Abstract descriptions of stabilizers and Clifford groups already cover arbitrary dimension. The missing piece is a circuit-level account: conventions, generators, normal forms, and small tests that a compiler could use.",
    firstSteps: [
      "Choose one composite test case, probably $d = 4$, and fix the phase and gate conventions.",
      "Compare the resulting gates with the arbitrary-dimensional stabilizer descriptions.",
      "Build a tiny verifier for equalities before trying to prove a general theorem.",
    ],
    links: [
      { label: "arbitrary-d stabilizers", href: refs.quditCliffordArbitraryD },
      { label: "Clifford ideals", href: refs.quditCliffordIdeal },
      { label: "Clifford review", href: refs.cliffordReview },
    ],
  },
  "offer-even-d-clifford": {
    question:
      "Which odd-prime Clifford arguments fail in even dimension, and which failures are only convention problems?",
    why:
      "Even-dimensional qudits show up naturally in hardware and encodings. Many odd-prime tricks stop being automatic there. A useful output would name the obstruction precisely.",
    firstSteps: [
      "Work in $d = 4$ and list the first identities that fail.",
      "Separate phase-convention issues from genuine algebraic obstructions.",
      "Look for one even-dimensional subfragment that still has a clean rewrite story.",
    ],
    links: [
      { label: "Clifford review", href: refs.cliffordReview },
      { label: "Clifford ideals", href: refs.quditCliffordIdeal },
      { label: "transmon qudit synthesis", href: refs.transmonQuditSynthesis },
    ],
  },
  "offer-lov-hadamard": {
    question:
      "Can the Fourier gate $H_d$ be generated and certified inside LOv for both prime and composite $d$?",
    why:
      "Fourier gates are a good stress test. They force the conventions to be explicit, and they give quick resource counts once the construction works.",
    firstSteps: [
      "Reproduce the $d = 2$ case inside the chosen LOv/LOfi conventions.",
      "Generate candidate circuits for $d = 3$ and $d = 5$.",
      "Check each circuit by matrix comparison and record the resource count.",
    ],
    links: [{ label: "LOfi/linear-optical calculus", href: refs.lofiCalculus }],
  },
  "offer-chevaliers": {
    question:
      "Which new levels would teach the printable circuit-game rules without turning the videogame into a textbook?",
    why:
      '"Les Chevaliers du Quantique" is the videogame version of a simplified circuit tutorial game. New levels should carry one visible learning goal and a guided solution.',
    firstSteps: [
      "Pick one rule from the printable circuit game and make a three-to-five-level sequence around it.",
      "Write short guided solutions that explain the circuit move behind each answer.",
      "Playtest with someone who has not seen the paper version.",
    ],
    links: [
      { label: "playable game", href: refs.chevaliersGame },
      { label: "short article", href: refs.chevaliersArticle },
    ],
  },
  "offer-qutrit-few-roots": {
    question:
      "Is there a qutrit analogue of the few-square-roots exact synthesis story, using cube roots instead?",
    why:
      "The qubit result suggests a qutrit test. Start with the arithmetic: small rings, small one-qutrit unitaries, and the first obstruction that shows up.",
    firstSteps: [
      "Choose a small candidate ring for one-qutrit unitaries.",
      "Search for exact decompositions of a few sample gates.",
      "Record the first obstruction instead of forcing the qubit proof to fit.",
    ],
    links: [
      { label: "few square roots", href: refs.fewSquareRoots },
      { label: "qutrit cyclotomic ideas", href: refs.qutritCyclotomic },
      { label: "single-qutrit Clifford+T", href: refs.singleQutritCliffordT },
    ],
  },
  "offer-geometric-algebra-qudits": {
    question:
      "Does geometric algebra make any qudit circuit calculation shorter, or is it mostly a change of language?",
    why:
      "A new formalism has to shorten something: a normal form, a synthesis step, or a proof. A translation exercise would make that visible quickly.",
    firstSteps: [
      "Translate one familiar qudit gate family into the formalism.",
      "Compare the length of one standard calculation before and after translation.",
      "Write down what the formalism cannot see easily.",
    ],
    links: [{ label: "qudit Clifford algebras", href: refs.quditCliffordAlgebras }],
  },
  "offer-promised-props": {
    question:
      "Can promise-style assumptions and controlled operations be handled in one PROP-level language?",
    why:
      "Controlled structure appears everywhere in circuits. Promise assumptions usually sit outside the diagram. Bringing them into the same language may simplify some transformations.",
    firstSteps: [
      "Pick one small promise fragment and write its controlled operations diagrammatically.",
      "Check whether ancilla-for-control conversions become structural.",
      "Keep only the equations that survive a concrete circuit example.",
    ],
    links: [
      { label: "polycontrolled PROPs", href: refs.polycontrolledProps },
      { label: "controlled PROPs", href: refs.controlledProps },
    ],
  },
  "offer-controlled-lawvere-theories": {
    question:
      "What is the smallest useful definition of a controlled Lawvere theory?",
    why:
      "A definition here needs a small example quickly. Finite-field functions and controlled classical gates are the first test case.",
    firstSteps: [
      "Write the minimal definition, without trying to solve every variant at once.",
      "Test it on $q$-reduced polynomial functions over a finite field.",
      "Look for one theorem that is cleaner because control is part of the structure.",
    ],
    links: [
      { label: "controlled PROPs", href: refs.controlledProps },
      { label: "graphical algebraic geometry", href: refs.graphicalAlgebraicGeometry },
    ],
  },
  "offer-coxeter-fragment-classification": {
    question:
      "When a circuit fragment has a good normal form, is there a Coxeter, Artin, triangle, or reflection-group presentation hiding behind it?",
    why:
      "Small qubit fragments sometimes have finite-group shadows. Qudit fragments add arithmetic that may break the Coxeter picture. A useful project would compare a few fragments side by side and ask which presentations explain their normal forms.",
    firstSteps: [
      "Start with one-qubit Clifford and real subfragments, recording which generators are involutions and which relations are braid-like.",
      "Add CNOT-dihedral or phase-polynomial fragments and separate true group relations from rewrite conveniences.",
      "Repeat the exercise for a qutrit or qupit fragment and write down exactly where the Coxeter picture breaks.",
    ],
    links: [
      { label: "circuit presentations", href: refs.circuitPresentations },
      { label: "CNOT-dihedral presentation", href: refs.cnotDihedralPresentation },
      { label: "Clifford review", href: refs.cliffordReview },
    ],
  },
  "offer-scaling-generators": {
    question:
      "Do prime-dimensional affine/phase calculi really need a full family of scaling generators?",
    why:
      "The scaling family is a compact place to test redundancy. Derivable scalings would simplify the presentation; a counterexample would say what the fragment is remembering.",
    firstSteps: [
      "Pick one toy fragment and remove most of the scaling family.",
      "Check which local rewrites still work.",
      "Try to derive the missing scalings or produce a small countermodel.",
    ],
    links: [{ label: "prime affine-diagonal fragments", href: refs.primeAffineDiagonalFragments }],
  },
  "offer-beyond-prime-dimensions": {
    question:
      "What should affine-plus-diagonal calculi look like over prime powers or finite rings?",
    why:
      "Prime fields make many proofs clean. Composite settings are messier and cannot stay as an afterthought.",
    firstSteps: [
      "Choose prime powers or rings as the first target.",
      "Write the smallest possible generator list.",
      "Test whether the prime-dimensional normal form has a recognizable replacement.",
    ],
    links: [
      { label: "phase polynomials for qudits", href: refs.phasePolynomialsQudit },
      { label: "prime affine-diagonal fragments", href: refs.primeAffineDiagonalFragments },
    ],
  },
  "offer-higher-degree-phase-hierarchies": {
    question:
      "Which new generators appear when qudit phase functions move beyond low degree?",
    why:
      "Low-degree phase fragments are already useful. Higher-degree behavior should say more about the hierarchy of qudit resources.",
    firstSteps: [
      "Work out degree 4 in one prime dimension.",
      "Find the first phase function that cannot be built from the smaller fragment.",
      "Turn that example into a proposed generator or obstruction.",
    ],
    links: [
      { label: "qutrit phase gadgets", href: refs.qutritPhaseGadgets },
      { label: "qudit phase-gadget method", href: refs.quditPhaseGadgetMethod },
      { label: "qubit phase polynomials", href: refs.phasePolynomialsQubit },
    ],
  },
  "offer-two-level-x-phase-affine": {
    question:
      "How much of the prime-dimensional phase-affine world is already generated by $X^{a,b}$, $\\mathrm{CX}$, and a few phases?",
    why:
      "These are my current notes: a sparse fragment with explicit decompositions, zero-sum diagonal examples, and controlled phases that should become synthesis statements.",
    firstSteps: [
      "Clean the current decomposition notes for $p \\ge 5$.",
      "Make the zero-sum diagonal examples readable.",
      "Explain where $\\mathrm{CZ}$, $\\mathrm{CCZ}$, and controlled phases enter.",
    ],
    links: [
      { label: "phase polynomials for qudits", href: refs.phasePolynomialsQudit },
      { label: "prime affine-diagonal fragments", href: refs.primeAffineDiagonalFragments },
    ],
  },
  "offer-qudit-zx-extraction": {
    question:
      "Can we extract circuits from qudit ZX diagrams without first solving every possible diagrammatic fragment?",
    why:
      "A full arbitrary-dimensional extraction theory is a lot. A useful prototype can be narrower: pick one normal form, one target gate set, and one benchmark family.",
    firstSteps: [
      "Choose a small extractable class of diagrams.",
      "Define the target qudit gate set.",
      "Run extraction on hand-made examples before touching random benchmarks.",
    ],
    links: [
      { label: "complete ZX thesis", href: refs.zxCompleteThesis },
      { label: "finite-dimensional ZX", href: refs.zxCompleteFiniteDim },
      { label: "PyZX", href: refs.pyzx },
    ],
  },
  "offer-qutrit-zx-extraction": {
    question:
      "Can a qutrit-only extractor be made simple enough to be a real tool?",
    why:
      "Qutrits are a good middle ground: richer than qubits, much less sprawling than arbitrary $d$.",
    firstSteps: [
      "Pick one qutrit simplification pass.",
      "Define a tiny extracted gate set.",
      "Build a toy dataset and measure where extraction fails.",
    ],
    links: [
      { label: "qutrit ZX stabilizer completeness", href: refs.qutritZXStabilizerComplete },
      { label: "ZX graph simplification", href: refs.zxGraphSimplification },
    ],
  },
  "offer-two-level-zx": {
    question:
      "What would a diagrammatic calculus look like if two-level qudit gates were primitive?",
    why:
      "Two-level operations are natural in synthesis and hardware. A ZX-like syntax has to use them without collapsing into ordinary circuit notation.",
    firstSteps: [
      "Choose the two-level generators and their semantics.",
      "Write the first local rewrite rules.",
      "Compare against a small hardware-native synthesis example.",
    ],
    links: [
      { label: "qudit ZH", href: refs.quditZH },
      { label: "ZH calculus", href: refs.zhIntro },
      { label: "ZX extraction hardness", href: refs.zxExtractionHardness },
    ],
  },
  "offer-single-qupit-clifford-t": {
    question:
      "What is the clean one-wire exact synthesis story for single-qupit Clifford+T-like fragments?",
    why:
      "One wire is the right place to be strict about arithmetic before adding controls, entanglement, and layout.",
    firstSteps: [
      "Fix one prime dimension and one gate set.",
      "Implement exact synthesis for a small sample of unitaries.",
      "Compare the normal form with known qutrit and qudit exact-synthesis results.",
    ],
    links: [
      { label: "single-qudit Clifford+T", href: refs.singleQuditCliffordT },
      { label: "single-qutrit Clifford+T", href: refs.singleQutritCliffordT },
      { label: "multi-qutrit exact synthesis", href: refs.multiQutritExactSynthesis },
    ],
  },
  "offer-controlled-x-algorithms": {
    question:
      "Do generalized qudit controlled-X decompositions improve any real algorithm block?",
    why:
      "Use benchmarks here. The point is to find where qudit encodings save depth, gates, or storage.",
    firstSteps: [
      "Choose one arithmetic, oracle, or lookup block.",
      "Implement the qubit and qudit versions with the same metric conventions.",
      "Plot the first compression/depth/storage tradeoff.",
    ],
    links: [
      { label: "multi-controlled qudit gates", href: refs.multiControlledQudit },
      { label: "qudit review", href: refs.quditsReview },
    ],
  },
  "offer-fault-tolerance-by-construction": {
    question:
      "Can fault-tolerance-by-construction ideas be stated for qudit rewrite systems?",
    why:
      "Rewrite rules are only useful in a fault-tolerant setting if they respect the code or noise model being used. For qudits, those choices are less settled.",
    firstSteps: [
      "Choose one tiny qudit noise or code model.",
      "Define what it means for one rewrite to be safe.",
      "Test the definition on a small set of circuit equations.",
    ],
    links: [
      { label: "fault tolerance by construction", href: refs.faultToleranceByConstruction },
      { label: "qudit fault tolerance", href: refs.quditFaultTolerance },
    ],
  },
  "offer-clifford-ancilla-minimisation": {
    question:
      "How much depth or gate count can Clifford circuits save if we allow a fixed number of ancillas?",
    why:
      "The output should be a frontier: plots or bounds for ancillas versus depth or gate count.",
    firstSteps: [
      "Pick one small Clifford family and one metric pair, such as ancillas versus depth.",
      "Model the search with SAT, dynamic programming, or brute force for very small sizes.",
      "Compare the first frontier with known CNOT and Clifford optimization results.",
    ],
    links: [
      { label: "Q-Synth", href: refs.qsynthPaper },
      { label: "depth-optimal Clifford SAT", href: refs.depthOptimalCliffordSAT },
      { label: "CNOT space-depth tradeoff", href: refs.cnotSpaceDepthTradeoff },
      { label: "ancilla cost tradeoff", href: refs.ancillaCostTradeoff },
    ],
  },
};

const allPosts = import.meta.env.DEV
  ? (
      await getCollection("posts", ({ data }) => {
        return import.meta.env.PROD ? data.draft !== true : true;
      })
    ).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : [];

const topicSections = topics.map((topic) => {
  const offers = offerSummariesByTopic[topic.key];
  return {
    ...topic,
    offers,
    ideaCount: offers.length,
  };
});

const knownKeys = new Set(topics.map((topic) => topic.key.toLowerCase()));
const postsWithUnknownKeys = allPosts
  .filter((post) => (post.data.research ?? []).some((key) => !knownKeys.has(key.toLowerCase())))
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    extra: (post.data.research ?? []).filter((key) => !knownKeys.has(key.toLowerCase())),
  }));

const focusNow = [
  {
    title: "How much do two-level swaps, CX, and a few phases express?",
    offerId: "offer-two-level-x-phase-affine",
    note: "The qudit fragment I most want to polish next: sparse gates, explicit decompositions, and a theorem-level story for prime dimension.",
    status: "Current focus",
    statusClass: "pill--focus",
  },
];

const legend = [
  { label: "Current focus", cls: "pill--focus", text: "I am already close to this." },
  { label: "Open / exploratory", cls: "pill--open", text: "Good question; scope may move." },
  { label: "Tomorrow-problem", cls: "pill--incubating", text: "Worth keeping warm; not my main work this week." },
  { label: "Backlog / parked", cls: "pill--parked", text: "Needs a driven collaborator." },
];

const offerModals: Array<{ offer: OfferSummary; detail: OfferDetail }> = [];
for (const offer of offerSummaries) {
  const detail = offerDetails[offer.id];
  if (detail) offerModals.push({ offer, detail });
}
---

<BaseLayout
  title="Ideas"
  description="Research and collaboration ideas around qudit circuits, rewriting, exact synthesis, and outreach."
  includeKatex
>
  <article class="ideas">
    <header class="hero">
      <h1>Research ideas</h1>

      <p class="lead">
        A PhD-student page: problems for discussion, collaboration, or a
        concrete side project.
      </p>

      <p class="muted">
        Some ideas are close to my current work. Others are rougher and need a
        first pass before they deserve a bigger claim.
      </p>
    </header>

    <section id="right-now" class="spotlight" aria-label="Current focus">
      <h2>Right Now</h2>
      <p class="muted">
        My near-term energy is mostly going into talks and current qudit-fragment
        work. If I had to pick one research thread to sharpen next, it would be this one.
      </p>

      <div class="spotlight-grid">
        {focusNow.map((item) => (
          <button
            class="spotlight-card"
            type="button"
            data-offer-modal-trigger={item.offerId}
            aria-haspopup="dialog"
            aria-controls={`${item.offerId}-dialog`}
          >
            <div class="spotlight-head">
              <span class={`pill ${item.statusClass}`}>{item.status}</span>
            </div>
            <h3 class="spotlight-title" set:html={renderInlineMath(item.title)} />
            <p class="muted">{item.note}</p>
          </button>
        ))}
      </div>
    </section>

    <section id="topic-index" class="browse">
      <h2>Browse</h2>
      <p class="muted">
        Each topic links to cards below. The cards are intentionally short; click one
        for the actual question and first checks.
      </p>

      <div class="topic-grid">
        {topicSections.map((section) => (
          <a class="topic-card" href={`#topic-${section.key}`}>
            <div class="topic-card-head">
              <div class="topic-title">{section.title}</div>
              <span class={`pill ${section.statusClass}`}>{section.status}</span>
            </div>
            <p class="topic-desc muted">{section.description}</p>
            <div class="topic-meta">
              <span class="pill">
                {section.ideaCount} {section.ideaCount === 1 ? "idea" : "ideas"}
              </span>
              <span class="muted">Best for {section.bestFor}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="legend">
      <h2>Labels</h2>
      <ul class="legend-list">
        {legend.map((item) => (
          <li class="legend-item">
            <span class={`pill ${item.cls}`}>{item.label}</span>
            <span class="muted">{item.text}</span>
          </li>
        ))}
      </ul>
    </section>

    {topicSections.map((section) => (
      <section id={`topic-${section.key}`} class="research-section">
        <h2>{section.title}</h2>
        <div class="topic-meta">
          <span class={`pill ${section.statusClass}`}>{section.status}</span>
          <span class="pill">
            {section.ideaCount} {section.ideaCount === 1 ? "idea" : "ideas"}
          </span>
          <span class="muted">Best for {section.bestFor}</span>
        </div>
        <p class="muted">{section.description}</p>

        <div class="offer-browser-grid">
          {section.offers.map((offer) => <OfferPreviewCard offer={offer} />)}
        </div>
      </section>
    ))}

    {offerModals.map(({ offer, detail }) => (
      <OfferDetailModal id={offer.id} labelledBy={`${offer.id}-title`}>
        <h3 id={`${offer.id}-title`} class="offer-modal__title" set:html={renderInlineMath(offer.title)} />

        <div class="offer-modal__body">
          <OfferSummaryBlock offer={offer} />

          <p>
            <strong>Question:</strong>{" "}
            <span set:html={renderInlineMath(detail.question)} />
          </p>

          <p>
            <strong>Why this is here:</strong>{" "}
            <span set:html={renderInlineMath(detail.why)} />
          </p>

          <div class="first-steps">
            <p><strong>First checks:</strong></p>
            <ul>
              {detail.firstSteps.map((step) => (
                <li set:html={renderInlineMath(step)}></li>
              ))}
            </ul>
          </div>

          {detail.links ? (
            <p class="refs">
              <strong>Starting points:</strong>{" "}
              {detail.links.map((link, index) => (
                <>
                  {index > 0 ? ", " : ""}
                  <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                </>
              ))}
            </p>
          ) : null}
        </div>
      </OfferDetailModal>
    ))}

    {postsWithUnknownKeys.length ? (
      <details class="debug">
        <summary>Research-tag housekeeping</summary>
        <ul>
          {postsWithUnknownKeys.map((post) => (
            <li>
              {post.title} - missing topics for: {post.extra.join(", ")}
            </li>
          ))}
        </ul>
      </details>
    ) : null}
  </article>

  <script>
    (() => {
      const marker = "__offerModalBindings";
      if ((window as typeof window & { [key: string]: boolean })[marker]) return;
      (window as typeof window & { [key: string]: boolean })[marker] = true;

      function openOfferModal(id: string | undefined) {
        if (!id) return;
        const dialog = document.getElementById(`${id}-dialog`);
        if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
        dialog.showModal();
      }

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const trigger = target.closest("[data-offer-modal-trigger]");
        if (trigger instanceof HTMLElement) {
          event.preventDefault();
          openOfferModal(trigger.dataset.offerModalTrigger);
          return;
        }

        const closeButton = target.closest("[data-offer-modal-close]");
        if (closeButton instanceof HTMLElement) {
          const dialog = closeButton.closest("dialog");
          if (dialog instanceof HTMLDialogElement) dialog.close();
          return;
        }

        if (target instanceof HTMLDialogElement) {
          const rect = target.getBoundingClientRect();
          const clickedBackdrop =
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom;

          if (clickedBackdrop) target.close();
        }
      });
    })();
  </script>

