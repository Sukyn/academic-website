---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentDialog from "../components/ContentDialog.astro";
import OfferPreviewCard from "../components/OfferPreviewCard.astro";
import OfferSummaryBlock from "../components/OfferSummaryBlock.astro";
import {
  offerSummaries,
  offerSummariesByTopic,
  type OfferSummary,
} from "../data/offerSummaries";
import { focusNow, legend, offerDetails, topics, type OfferDetail } from "../data/offerDetails";
import { renderInlineMath } from "../lib/inlineMath";
import "katex/dist/katex.min.css";

const topicSections = topics.map((topic) => {
  const offers = offerSummariesByTopic[topic.key];
  return {
    ...topic,
    offers,
    ideaCount: offers.length,
  };
});

const offerModals: Array<{ offer: OfferSummary; detail: OfferDetail }> = [];
for (const offer of offerSummaries) {
  const detail = offerDetails[offer.id];
  if (detail) offerModals.push({ offer, detail });
}
---

<BaseLayout
  title="Ideas"
  description="Research and collaboration ideas around qudit circuits, rewriting, exact synthesis, and outreach."
  noindex
>
  <article class="ideas">
    <header class="hero">
      <h1>Research ideas</h1>

      <p class="lead">
        A PhD-student page: problems for discussion, collaboration, or a
        small side project.
      </p>

      <p class="muted">
        Some entries sit near my papers. Others begin with one calculation.
      </p>
    </header>

    <section id="right-now" class="spotlight" aria-label="Current focus">
      <h2>Right Now</h2>
      <p class="muted">
        Near-term work: talks, qudit fragments, and a few explicit decompositions.
      </p>

      <div class="spotlight-grid">
        {focusNow.map((item) => (
          <button
            class="spotlight-card"
            type="button"
            data-content-dialog={item.offerId}
            aria-haspopup="dialog"
            aria-controls={`${item.offerId}-dialog`}
          >
            <div class="spotlight-head">
              <span class={`pill ${item.statusClass}`}>{item.status}</span>
            </div>
            <h3 class="spotlight-title" set:html={renderInlineMath(item.title)} />
            <p class="muted">{item.note}</p>
          </button>
        ))}
      </div>
    </section>

    <section id="topic-index" class="browse">
      <h2>Browse</h2>
      <p class="muted">
        Each topic links to cards below. Click one for the calculation, test case,
        or references attached.
      </p>

      <div class="topic-grid">
        {topicSections.map((section) => (
          <a class="topic-card" href={`#topic-${section.key}`}>
            <div class="topic-card-head">
              <div class="topic-title">{section.title}</div>
              <span class={`pill ${section.statusClass}`}>{section.status}</span>
            </div>
            <p class="topic-desc muted">{section.description}</p>
            <div class="topic-meta">
              <span class="pill">
                {section.ideaCount} {section.ideaCount === 1 ? "idea" : "ideas"}
              </span>
              <span class="muted">Fits {section.bestFor}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="legend">
      <h2>Labels</h2>
      <ul class="legend-list">
        {legend.map((item) => (
          <li class="legend-item">
            <span class={`pill ${item.cls}`}>{item.label}</span>
            <span class="muted">{item.text}</span>
          </li>
        ))}
      </ul>
    </section>

    {topicSections.map((section) => (
      <section id={`topic-${section.key}`} class="research-section">
        <h2>{section.title}</h2>
        <div class="topic-meta">
          <span class={`pill ${section.statusClass}`}>{section.status}</span>
          <span class="pill">
            {section.ideaCount} {section.ideaCount === 1 ? "idea" : "ideas"}
          </span>
          <span class="muted">Fits {section.bestFor}</span>
        </div>
        <p class="muted">{section.description}</p>

        <div class="offer-browser-grid">
          {section.offers.map((offer) => <OfferPreviewCard offer={offer} />)}
        </div>
      </section>
    ))}

    {offerModals.map(({ offer, detail }) => (
      <ContentDialog id={offer.id} labelledBy={`${offer.id}-title`}>
        <h3 id={`${offer.id}-title`} class="dialog-title" set:html={renderInlineMath(offer.title)} />

        <div class="dialog-body">
          <OfferSummaryBlock offer={offer} />

          <p class="offer-line" set:html={renderInlineMath(detail.question)} />

          <p set:html={renderInlineMath(detail.why)} />

          <div class="first-steps">
            <ul>
              {detail.firstSteps.map((step) => (
                <li set:html={renderInlineMath(step)}></li>
              ))}
            </ul>
          </div>

          {detail.links ? (
            <p class="refs">
              <strong>Reading:</strong>{" "}
              <span>{detail.links.map((link, index) => (
                <span>{index > 0 ? ", " : ""}<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></span>
              ))}</span>
            </p>
          ) : null}
        </div>
      </ContentDialog>
    ))}

  </article>

  <style>
    .ideas {
      max-width: 60rem;
      margin: 0 auto;
    }

    .hero {
      margin-bottom: 1.5rem;
    }

    .lead {
      margin-top: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .spotlight {
      margin-top: 1.5rem;
      padding: 1rem 1.1rem;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
    }

    .spotlight-grid,
    .topic-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    @media (min-width: 760px) {
      .spotlight-grid,
      .topic-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .spotlight-card {
      appearance: none;
      display: block;
      width: 100%;
      border: 1px solid var(--color-border);
      padding: 0.9rem 1rem;
      background: var(--color-surface-2);
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .spotlight-card:hover {
      background: var(--color-surface);
    }

    .spotlight-card:focus-visible,
    .topic-card:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .spotlight-head {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .spotlight-title {
      margin: 0.2rem 0 0.35rem;
      color: var(--color-text);
    }

    .legend,
    .browse {
      margin-top: 2rem;
    }

    .legend-list {
      list-style: none;
      padding-left: 0;
      margin: 0.75rem 0 0;
      display: grid;
      gap: 0.5rem;
    }

    .legend-item {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .topic-card {
      text-decoration: none;
      border: 1px solid var(--color-border);
      padding: 0.9rem 1rem;
      background: var(--color-surface-2);
      color: inherit;
    }

    .topic-card:hover {
      background: var(--color-surface);
    }

    .topic-card-head {
      display: flex;
      gap: 0.75rem;
      align-items: start;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .topic-title {
      font-weight: 700;
      margin-bottom: 0.25rem;
      color: var(--color-text);
    }

    .topic-desc {
      margin: 0;
    }

    .topic-meta {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      margin-top: 0.6rem;
      flex-wrap: wrap;
    }

    .research-section {
      margin-top: 2rem;
      scroll-margin-top: 1rem;
    }

    .offer-browser-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 0.9rem;
    }

    .dialog-title {
      margin: 0 0 1rem;
    }

    .dialog-body > :last-child {
      margin-bottom: 0;
    }

    .offer-line {
      font-weight: 700;
      color: var(--color-heading);
    }

    .refs {
      margin-top: 1rem;
    }

    :global(.pill) {
      background: var(--color-surface);
    }

    :global(.pill--focus),
    :global(.pill--open),
    :global(.pill--incubating),
    :global(.pill--parked) {
      font-weight: 700;
      border-color: var(--color-border-strong);
    }
  </style>
</BaseLayout>
