    details.offer summary,
    details.offer-group summary {
      cursor: pointer;
      font-weight: 750;
      list-style: none;
    }

    details.offer summary::-webkit-details-marker,
    details.offer-group summary::-webkit-details-marker {
      display: none;
    }

    details.offer summary:focus-visible,
    details.offer-group summary:focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 3px;
      border-radius: 8px;
    }

    details.offer summary::before,
    details.offer-group summary::before {
      content: "▸";
      display: inline-block;
      margin-right: 0.55rem;
      transform: translateY(1px);
      transition: transform 140ms ease;
    }

    details.offer[open] summary::before,
    details.offer-group[open] summary::before {
      transform: rotate(90deg) translateY(1px);
    }

    details.offer .body,
    details.offer-group .body {
      margin-top: 0.75rem;
    }

    details.offer .body > :last-child,
    details.offer-group .body > :last-child {
      margin-bottom: 0;
    }

    .meta {
      margin-top: 0;
      margin-bottom: 0.85rem;
      display: flex;
      gap: 0.45rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .refs {
      margin-top: 1rem;
    }

    /* Small motion polish (disable if user prefers reduced motion) */
    details.offer[open] .body,
    details.offer-group[open] .body {
      animation: fadeSlide 160ms ease-out;
    }

    @keyframes fadeSlide {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .spotlight-card,
      .topic-card,
      details.offer summary::before,
      details.offer-group summary::before {
        transition: none;
      }

      details.offer[open] .body,
      details.offer-group[open] .body {
        animation: none;
      }
    }

    /* CTA */
    .cta {
      margin-top: 2.75rem;
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 1rem;
      background: color-mix(in oklab, var(--color-bg) 94%, var(--color-border) 6%);
    }

    .cta-link {
      font-weight: 750;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
    }
  </style>
</BaseLayout>
