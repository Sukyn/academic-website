    }

    .spotlight-card:focus-visible {
      outline: 3px solid var(--color-accent);
      outline-offset: 3px;
    }

    .spotlight-head {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .spotlight-title {
      margin: 0.2rem 0 0.35rem;
      font-size: 1.02rem;
      color: var(--color-text);
    }

    /* Legend */
    .legend {
      margin-top: 2rem;
    }

    .legend-list {
      list-style: none;
      padding-left: 0;
      margin: 0.75rem 0 0;
      display: grid;
      gap: 0.5rem;
    }

    .legend-item {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
    }

    /* Topic grid */
    .browse {
      margin-top: 2rem;
    }

    .topic-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    @media (min-width: 760px) {
      .topic-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .topic-card {
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 0.9rem;
      padding: 0.9rem 1rem;
      background: var(--color-bg);
      transition: transform 120ms ease, border-color 120ms ease, box-shadow 120ms ease;
    }

    .topic-card:hover {
      transform: translateY(-1px);
      border-color: color-mix(in oklab, var(--color-accent) 55%, var(--color-border) 45%);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    }

    .topic-card-head {
      display: flex;
      gap: 0.75rem;
      align-items: start;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .topic-title {
      font-weight: 750;
      margin-bottom: 0.25rem;
      color: var(--color-text);
    }

    .topic-desc {
      margin: 0;
    }

    .topic-meta {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      margin-top: 0.6rem;
      flex-wrap: wrap;
    }

    .offer-browser {
      margin-top: 1.25rem;
    }

    .offer-browser-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    @media (min-width: 760px) {
      .offer-browser-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    /* Posts list */
    .research-section {
      margin-top: 2.5rem;
      scroll-margin-top: 5rem;
    }

    /* Tags & pills */
    :global(.tag) {
      display: inline-block;
      padding: 0.12rem 0.5rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font-size: 0.9rem;
      line-height: 1.2;
      background: color-mix(in oklab, var(--color-bg) 92%, var(--color-border) 8%);
    }

    :global(.pill) {
      display: inline-block;
      padding: 0.12rem 0.5rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font-size: 0.9rem;
      line-height: 1.2;
      transform: translateY(-1px);
      background: color-mix(in oklab, var(--color-bg) 94%, var(--color-border) 6%);
    }

    :global(.pill--focus) {
      background: color-mix(in oklab, var(--color-bg) 84%, var(--color-accent) 16%);
      border-color: color-mix(in oklab, var(--color-border) 60%, var(--color-accent) 40%);
    }

    :global(.pill--open) {
      background: color-mix(in oklab, var(--color-bg) 90%, var(--color-accent) 10%);
      border-color: color-mix(in oklab, var(--color-border) 70%, var(--color-accent) 30%);
    }

    :global(.pill--incubating) {
      background: color-mix(in oklab, var(--color-bg) 92%, orange 8%);
      border-color: color-mix(in oklab, var(--color-border) 78%, orange 22%);
    }

    :global(.pill--parked) {
      background: color-mix(in oklab, var(--color-bg) 94%, var(--color-border) 6%);
      opacity: 0.95;
    }

    .offer-modal__title {
      margin: 0 0 1rem;
      padding-right: 0;
    }

    .offer-modal__body > :last-child {
      margin-bottom: 0;
    }

    .refs {
      margin-top: 1rem;
    }

    @media (prefers-reduced-motion: reduce) {
      .spotlight-card,
      .topic-card {
        transition: none;
      }
    }

    /* CTA */
    .cta {
      margin-top: 2.75rem;
      padding: 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 1rem;
      background: color-mix(in oklab, var(--color-bg) 94%, var(--color-border) 6%);
    }

    .cta-link {
      font-weight: 750;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
    }
  </style>
</BaseLayout>

