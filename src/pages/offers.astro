---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferDetailModal from "../components/OfferDetailModal.astro";
import OfferPreviewCard from "../components/OfferPreviewCard.astro";
import OfferSummaryBlock from "../components/OfferSummaryBlock.astro";
import { getCollection } from "astro:content";
import { offerSummariesByTopic, offerSummaryById } from "../data/offerSummaries";

/**
 * Centralised reference list so the page stays maintainable.
 * (All links are public entry points: arXiv, journals, or project pages.)
 */
const refs = {
  // --- Clifford groups / axiomatization (qudits & qubits)
  quditCliffordArbitraryD: "https://arxiv.org/abs/quant-ph/0506065",
  quditCliffordIdeal: "https://arxiv.org/abs/1307.5087",
  cliffordReview: "https://arxiv.org/abs/1810.10259",

  // --- CNOT-dihedral / phase polynomials
  cnotDihedralPresentation: "https://arxiv.org/abs/1701.00140",
  cnotDihedralSynthesis: "https://arxiv.org/abs/2006.12042",
  phasePolynomialsQubit: "https://arxiv.org/abs/1303.2042",
  phasePolynomialsQudit: "https://arxiv.org/abs/1902.05634",
  qutritPhaseGadgets: "https://arxiv.org/abs/2204.13681",
  quditPhaseGadgetMethod: "https://arxiv.org/abs/2504.12710",

  // --- My current affine-plus-diagonal work (placeholder until the arXiv exists)
  primeAffineDiagonalFragments: "https://arxiv.org/abs/2603.06466",

  // --- Control as structure / promise-style control
  polycontrolledProps: "https://arxiv.org/abs/2602.09873",
  controlledProps: "https://arxiv.org/abs/2508.21756",
  comparatorsIncrementers: "https://arxiv.org/abs/2603.12917",

  // --- ZX / ZH calculi & tooling
  zxCompleteThesis: "https://arxiv.org/abs/2209.14894",
  zxCompleteFiniteDim: "https://arxiv.org/abs/2405.10896",
  qutritZXStabilizerComplete: "https://arxiv.org/abs/1803.00696",
  pyzx: "https://arxiv.org/abs/1904.04735",
  zxGraphSimplification: "https://arxiv.org/abs/1902.03178",
  zxExtractionHardness: "https://arxiv.org/abs/2202.09194",

  zhIntro: "https://arxiv.org/abs/1805.02175",
  zhComplete: "https://arxiv.org/abs/2103.06610",
  zhPathsums: "https://arxiv.org/abs/2003.13564",
  quditZH: "https://arxiv.org/abs/2307.10095",

  // --- Local complementation / hypergraphs
  localComplementationGraphStates: "https://arxiv.org/abs/quant-ph/0410154",
  hypergraphLocalComplementation: "https://arxiv.org/abs/1612.01447",
  hypergraphReview: "https://arxiv.org/abs/2512.02955",
  lcOrbits: "https://quantum-journal.org/papers/q-2020-08-07-305/",

  // --- Qudit algorithms / gate synthesis
  quditsReview: "https://arxiv.org/abs/2008.00959",
  quditCircuitsUniversal: "https://arxiv.org/abs/quant-ph/0509161",
  multiControlledQudit: "https://arxiv.org/abs/2303.12979",
  transmonQuditSynthesis: "https://arxiv.org/abs/2212.04496",

  // --- Fault tolerance
  faultToleranceByConstruction: "https://arxiv.org/abs/2506.17181",
  quditFaultTolerance: "https://arxiv.org/abs/quant-ph/9802007",

  // --- Exact synthesis / cyclotomic
  fewSquareRoots: "https://arxiv.org/abs/2310.14056",
  qutritCyclotomic: "https://arxiv.org/abs/2303.13644",
  singleQutritCliffordT: "https://arxiv.org/abs/1803.05047",
  singleQuditCliffordT: "https://arxiv.org/abs/2011.07970",
  multiQutritExactSynthesis: "https://arxiv.org/abs/2405.08136",

  // --- Circuit equations / rewriting foundations
  equationalTheoryComplete: "https://arxiv.org/abs/2206.10577",
  equationalTheoryMinimal: "https://arxiv.org/abs/2311.07476",

  // --- Optimisation / synthesis (Clifford / CNOT / ancillas)
  qsynthPaper: "https://arxiv.org/abs/2504.00634",
  depthOptimalCliffordSAT: "https://arxiv.org/abs/2305.01674",
  qsynthRepo: "https://github.com/irfansha/Q-Synth",
  cnotSpaceDepthTradeoff: "https://arxiv.org/abs/1907.05087",
  ancillaCostTradeoff: "https://arxiv.org/abs/1405.6073",

  // --- Alternative algebraic viewpoints
  quditCliffordAlgebras: "https://arxiv.org/abs/1809.07809",

  // --- Linear optics / LOv / LOfi
  lofiCalculus: "https://arxiv.org/abs/2402.17693",

  // --- Outreach
  chevaliersGame: "https://sukyn.itch.io/les-chevaliers-du-quantique",
  chevaliersArticle:
    "https://tice-education.fr/tous-les-articles-erun/1236-les-chevaliers-du-quantique",
};

/**
 * Category hub for this page:
 * - You list categories you have ideas for.
 * - In development, research keys are cross-checked against posts to catch taxonomy drift.
 *
 * IMPORTANT: these keys come from frontmatter `research: [...]` in posts.
 * Example: research: ["equational-theory", "circuit-fragments"]
 */
const topics = [
  {
    key: "qudit-clifford",
    title: "Qudit Clifford structure & tooling",
    description:
      "Prime and composite dimensions, presentations, normal forms, and rewriting-friendly tooling.",
    ideaCount: 2,
    status: "Current focus",
    statusClass: "pill--focus",
    bestFor: "researchers or self-directed M2/PhD-level collaborators who also enjoy proof assistants or tooling",
  },
  {
    key: "linear-optics",
    title: "Linear optics (LOv/LOfi)",
    description:
      "Linear-optical circuit calculi, normal forms, and structured Fourier/Hadamard constructions.",
    ideaCount: 1,
    status: "Open / exploratory",
    statusClass: "pill--open",
    bestFor: "researchers or independent collaborators who like constructive synthesis and concrete benchmarks",
  },
  {
    key: "outreach",
    title: "Outreach & educational tooling",
    description:
      "Student-facing projects: playable content, web ports, and guided solution material.",
    ideaCount: 1,
    status: "Actively looking for help",
    statusClass: "pill--open",
    bestFor: "collaborators who want a fast first deliverable with outreach value",
  },
  {
    key: "algebraic-viewpoints",
    title: "Alternative algebraic viewpoints",
    description:
      "Cyclotomic/exact synthesis perspectives, Clifford/geometric algebra formalisms, and compiler-friendly representations.",
    ideaCount: 3,
    status: "Tomorrow-problem",
    statusClass: "pill--incubating",
    bestFor: "self-directed researchers or advanced students with a strong algebra background",
  },
  {
    key: "equational-theory",
    title: "Equational theories & rewriting",
    description: "Axioms, completeness and minimality questions, normal forms, and rewriting systems.",
    ideaCount: 4,
    status: "Current focus",
    statusClass: "pill--focus",
    bestFor: "researchers who want theorem work with compiler consequences",
  },
  {
    key: "circuit-fragments",
    title: "Circuit fragments & expressivity",
    description:
      "Gate sets, fragments, expressivity, and reasoning inside fragments.",
    ideaCount: 4,
    status: "Current focus",
    statusClass: "pill--focus",
    bestFor: "researchers who already know the direction they want",
  },
  {
    key: "zx-zh",
    title: "Diagrammatic reasoning (ZX/ZH)",
    description:
      "Graphical calculi, rewriting automation, extraction, and tooling.",
    ideaCount: 3,
    status: "Backlog / parked",
    statusClass: "pill--parked",
    bestFor: "implementation-heavy collaborators who want a graphical-calculus project",
  },
];

// Load posts (hide drafts in prod)
const allPosts = import.meta.env.DEV
  ? (
      await getCollection("posts", ({ data }) => {
        return import.meta.env.PROD ? data.draft !== true : true;
      })
    ).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : [];

const topicSections = topics.map((t) => ({
  ...t,
  offers: offerSummariesByTopic[t.key as keyof typeof offerSummariesByTopic],
}));

// (Optional) quick check: posts with research keys not covered by topics (useful while tagging)
const knownKeys = new Set(topics.map((t) => t.key.toLowerCase()));
const postsWithUnknownKeys = allPosts
  .filter((p) => (p.data.research ?? []).some((k) => !knownKeys.has(k.toLowerCase())))
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    extra: (p.data.research ?? []).filter((k) => !knownKeys.has(k.toLowerCase())),
  }));

const focusNow = [
  {
    title: "LOv: structured decomposition of the generalized Hadamard / Fourier gate",
    offerId: "offer-lov-hadamard",
    note: "A good match if you like explicit constructions, matrix identities, and turning a pattern into a small generator or benchmark.",
    status: "Open / exploratory",
    statusClass: "pill--open",
  },
  {
    title: '"Les Chevaliers du Quantique": extensions + challenge packs + guided solutions',
    offerId: "offer-chevaliers",
    note: "The playable web version exists now; the next step is to extend it with stronger content, challenge structure, and clearer pedagogy.",
    status: "Actively looking for help",
    statusClass: "pill--open",
  },
];

const legend = [
  { label: "Current focus", cls: "pill--focus", text: "I'm highly motivated to work on this now." },
  { label: "Open / exploratory", cls: "pill--open", text: "I like it, but scope may evolve." },
  { label: "Tomorrow-problem", cls: "pill--incubating", text: "Interested, still building background." },
  { label: "Backlog / parked", cls: "pill--parked", text: "Not my current focus; only if you're very driven." },
];
---

<BaseLayout
  title="Ideas"
  description="Research and collaboration ideas with clear priority signals, practical fit notes, and related reading."
>
  <article class="ideas">
    <header class="hero">
      <h1>Research ideas and collaboration directions</h1>

      <p class="lead">
        I am currently a PhD student, so this is <strong>not</strong> a supervision
        page. It is mainly a map of research problems I would be excited to
        discuss with other researchers, plus a small number of lighter side
        projects.
      </p>

      <p class="muted">
        If something clicks, <a href="/contact">write to me</a>.
      </p>
    </header>

    <section id="right-now" class="spotlight" aria-label="Current focus">
      <h2>Right now</h2>
      <p class="muted">
        If you only read one part of this page, read this: these are the ideas I would be happiest to push forward
        soon.
      </p>

      <div class="spotlight-grid">
        {focusNow.map((x) => (
          <button
            class="spotlight-card"
            type="button"
            data-offer-modal-trigger={x.offerId}
            aria-haspopup="dialog"
            aria-controls={`${x.offerId}-dialog`}
          >
            <div class="spotlight-head">
              <span class={`pill ${x.statusClass}`}>{x.status}</span>
            </div>
            <h3 class="spotlight-title">{x.title}</h3>
            <p class="muted">{x.note}</p>
          </button>
        ))}
      </div>
    </section>

    <section id="topic-index" class="browse">
      <h2>Browse by topic</h2>
      <p class="muted">
        Each card tells you where my energy currently is, how much material lives there, and who the topic usually fits
        best.
      </p>

      <div class="topic-grid">
        {topicSections.map((s) => (
          <a class="topic-card" href={`#topic-${s.key}`}>
            <div class="topic-card-head">
              <div class="topic-title">{s.title}</div>
              <span class={`pill ${s.statusClass}`}>{s.status}</span>
            </div>
            <p class="topic-desc muted">{s.description}</p>
            <div class="topic-meta">
              <span class="pill">{s.ideaCount} {s.ideaCount === 1 ? "idea" : "ideas"}</span>
              <span class="muted">Best for {s.bestFor}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="legend">
      <h2>How to read the labels</h2>
      <ul class="legend-list">
        {legend.map((l) => (
          <li class="legend-item">
            <span class={`pill ${l.cls}`}>{l.label}</span>
            <span class="muted">{l.text}</span>
          </li>
        ))}
      </ul>
    </section>

    {topicSections.map((s) => (
      <section id={`topic-${s.key}`} class="research-section">
        <h2>{s.title}</h2>
        <div class="topic-meta">
          <span class={`pill ${s.statusClass}`}>{s.status}</span>
          <span class="pill">{s.ideaCount} {s.ideaCount === 1 ? "idea" : "ideas"}</span>
          <span class="muted">Best for {s.bestFor}</span>
        </div>
        <p class="muted">{s.description}</p>

        {/* -------------------- OFFERS BY TOPIC -------------------- */}
        {s.key === "qudit-clifford" ? (
          <>
            <p class="muted">
              A <strong>qudit</strong> is a <em>d</em>-level quantum system (a qubit is <em>d=2</em>, a qutrit is <em>d=3</em>).
              <strong>Clifford</strong> circuits are the structured gate family behind stabilizer error correction and many
              compilation and verification methods.
            </p>

            <OfferDetailModal
              id="offer-arbitrary-d-clifford"
              labelledBy="offer-arbitrary-d-clifford-title"
            >
              <h3 id="offer-arbitrary-d-clifford-title" class="offer-modal__title">
                Axiomatization of Clifford circuits for qudits (arbitrary dimension d, including composite)
              </h3>

              <div class="offer-modal__body">
                <OfferSummaryBlock offer={offerSummaryById["offer-arbitrary-d-clifford"]} />

                <p>
                  <strong>Goal:</strong> Extend Clifford-circuit axiomatizations beyond prime <em>p</em> to
                  <strong>arbitrary dimension d</strong> (including composite <em>d</em>), and produce:
                </p>
                <ul>
                  <li>a clear choice of generators for "arbitrary-d Clifford circuits" (including phase conventions),</li>
                  <li>a practical <strong>normal form</strong> (what is "canonical" in composite d?),</li>
                  <li>an implementation strategy (e.g., rewriting + decision procedure) and a benchmark suite.</li>
                </ul>

                <p>
                  This matters because many realistic platforms and encodings naturally produce composite dimensions
                  (e.g. <em>d=4</em>), and dimension-generic compilation/verification is a key missing piece for qudit tooling.
                </p>

                <p>
                  <strong>State of the art:</strong>
                  <strong>Already done:</strong> constructive stabilizer/Clifford descriptions exist for arbitrary dimensions, and
                  there are "dimension-uniform" viewpoints.
                  <strong>Still open:</strong> a small, usable circuit rewrite theory that stays manageable in composite dimensions,
                  with a clean normal form and an implementation that works in practice.
                  (<a href={refs.quditCliffordArbitraryD} target="_blank" rel="noopener noreferrer">quant-ph/0506065</a>,
                  <a href={refs.quditCliffordIdeal} target="_blank" rel="noopener noreferrer">arXiv:1307.5087</a>,
                  <a href={refs.cliffordReview} target="_blank" rel="noopener noreferrer">arXiv:1810.10259</a>)
                </p>
              </div>
            </OfferDetailModal>

            <OfferDetailModal
              id="offer-even-d-clifford"
              labelledBy="offer-even-d-clifford-title"
            >
              <h3 id="offer-even-d-clifford-title" class="offer-modal__title">
                Axiomatization of Clifford circuits in even dimensions (power-of-two and beyond)
              </h3>

              <div class="offer-modal__body">
                <OfferSummaryBlock offer={offerSummaryById["offer-even-d-clifford"]} />

                <p>
                  <strong>Goal:</strong> Pin down what "breaks" in even dimensions, then build an axiomatization (rules + normal
                  form) tailored to <strong>even-d Clifford circuits</strong> (e.g. ququarts <em>d=4</em>, or more generally
                  <em>d=2^k</em>).
                </p>

                <p>
                  This matters because many experimental qudit platforms naturally provide access to higher transmon levels
                  (often <em>d=4</em> is a very concrete target), and even-d is where many odd-prime tricks stop being plug-and-play.
                </p>

                <p>
                  <strong>State of the art:</strong>
                  <strong>Already done:</strong> general Clifford reviews exist; hardware-motivated compilation work exists for even-d
                  systems.
                  <strong>Still open:</strong> a rewriting-oriented axiomatization that cleanly handles even-d subtleties and supports
                  automated normalization.
                  (<a href={refs.cliffordReview} target="_blank" rel="noopener noreferrer">arXiv:1810.10259</a>,
                  <a href={refs.quditCliffordIdeal} target="_blank" rel="noopener noreferrer">arXiv:1307.5087</a>,
                  <a href={refs.transmonQuditSynthesis} target="_blank" rel="noopener noreferrer">arXiv:2212.04496</a>)
                </p>
              </div>
            </OfferDetailModal>
          </>
        ) : null}

        {s.key === "linear-optics" ? (
          <>
            <p class="muted">
              In single-photon encodings, a photon delocalised over <em>d</em> modes behaves like a <strong>d-level</strong> system.
              LOv/LOfi-style graphical calculi represent linear-optical circuits built from <strong>beam splitters</strong> and{" "}
              <strong>phase shifters</strong>, and support rewriting/normal forms.
            </p>

            <OfferDetailModal id="offer-lov-hadamard" labelledBy="offer-lov-hadamard-title">
              <h3 id="offer-lov-hadamard-title" class="offer-modal__title">
                Generalized Hadamard (Fourier) gates in LOv-calculus (prime & composite dimensions)
              </h3>

              <div class="offer-modal__body">
                <OfferSummaryBlock offer={offerSummaryById["offer-lov-hadamard"]} />

                <p>
                  <strong>Goal:</strong> Develop a <em>dimension-generic</em> and <em>rewrite-friendly</em> construction of the
                  generalized Hadamard gate <strong>H<sub>d</sub></strong> (i.e. the discrete Fourier transform / "mode-mixing" unitary)
                  as an LOv/linear-optical circuit (beam splitters + phase shifters), with a clear story for <strong>prime</strong>{" "}
                  <em>d</em> and <strong>composite</strong> <em>d</em>.
                </p>

                <ul>
                  <li>
                    Specify the exact convention: which matrix you call <strong>H<sub>d</sub></strong> (phases / global phase), and
                    which LOv generators you allow.
                  </li>
                  <li>
                    Produce explicit circuits for small primes (start with <em>d=2,3,5</em> and push toward <em>d=7</em>), and
                    identify reusable substructures.
                  </li>
                  <li>
                    Implement a generator: input <em>d</em> &rarr; output a circuit (plus a verifier that checks the produced matrix
                    matches <strong>H<sub>d</sub></strong>).
                  </li>
                  <li>
                    Extend to composite dimensions by a recursive scheme based on prime-factor "oracles" (e.g. build{" "}
                    <strong>H<sub>d<sup>k</sup></sub></strong> from <strong>H<sub>d</sub></strong>, and{" "}
                    <strong>H<sub>dd'</sub></strong> from <strong>H<sub>d</sub></strong> and <strong>H<sub>d'</sub></strong>).
                  </li>
                  <li>Benchmark resource counts (beam splitters, phase shifters, depth) vs baseline decompositions.</li>
                </ul>

                <p>
                  <strong>Why it matters:</strong> Fourier/Hadamard mixing is a central primitive behind QFT-like transforms,
                  state preparation, and interferometer constructions. Having a structured, dimension-parametric synthesis
                  (especially for composite <em>d</em>) can become a reusable compiler pass and a good testbed for LOv rewriting.
                </p>

                <p>
                  <strong>State of the art:</strong> LOv/LOfi-style calculi provide principled rewriting for linear optics, and have
                  also been used as a bridge to complete equational theories for standard quantum circuits. The missing piece
                  here is a specialised, scalable, implementation-ready synthesis story for <strong>H<sub>d</sub></strong> that exploits
                  Fourier structure rather than treating it as an arbitrary unitary.
                  (<a href={refs.lofiCalculus} target="_blank" rel="noopener noreferrer">arXiv:2402.17693</a>,
                  <a href={refs.equationalTheoryComplete} target="_blank" rel="noopener noreferrer">arXiv:2206.10577</a>,
                  <a href={refs.equationalTheoryMinimal} target="_blank" rel="noopener noreferrer">arXiv:2311.07476</a>)
                </p>

                <p class="refs">
                  <strong>Starting point:</strong> <a href="/notes/generalized-hadamard-gates.pdf">PDF notes (draft)</a>.
                </p>
              </div>
            </OfferDetailModal>
          </>
        ) : null}

        {s.key === "outreach" ? (
          <>
            <OfferDetailModal id="offer-chevaliers" labelledBy="offer-chevaliers-title">
              <h3 id="offer-chevaliers-title" class="offer-modal__title">
                Extend the outreach game "Les Chevaliers du Quantique" (new content + challenge packs + guided solutions)
              </h3>

              <div class="offer-modal__body">
                <OfferSummaryBlock offer={offerSummaryById["offer-chevaliers"]} />

                <p>
                  <strong>Goal:</strong> Build on the existing <strong>playable web version</strong> with clearly scoped
                  extensions:
                </p>
                <ul>
                  <li>design new levels or challenge packs with explicit learning objectives, including extra rules,</li>
                  <li>write/record short solution videos (explain the reasoning, not just the answer),</li>
                  <li>improve progression, onboarding, and the guided pedagogical layer around the web version,</li>
                  <li>upgrade the quality of the physical game as well potentially,</li>
                  <li>optionally run a lightweight evaluation (pre/post quiz or small user study).</li>
                </ul>

                <p class="muted">
                  I'm not a game developer, so I'll happily take a "make it work, keep it simple" approach but I would
                  really love to have someone co-driving this.
                </p>

                <p>
                  <strong>State of the art:</strong> the game exists publicly as an educational resource, and the web version
                  is now playable. The open part is extending it with more content, better guided solution material, and
                  (if desired) evidence about learning impact.
                  (<a href={refs.chevaliersGame} target="_blank" rel="noopener noreferrer">Game page</a>)
                </p>
              </div>
            </OfferDetailModal>
          </>
        ) : null}

        {s.key === "algebraic-viewpoints" ? (
          <>
            <OfferDetailModal
              id="offer-qutrit-few-roots"
              labelledBy="offer-qutrit-few-roots-title"
            >
              <h3 id="offer-qutrit-few-roots-title" class="offer-modal__title">
                Generalise "With a Few Square Roots, Quantum Computing is as Easy as &pi;" to qutrits (cube roots of unity)
              </h3>

              <div class="offer-modal__body">
                <OfferSummaryBlock offer={offerSummaryById["offer-qutrit-few-roots"]} />

                <p>
                  <strong>Goal:</strong> Investigate whether the "few square roots" representability phenomenon has a
                  <strong>qutrit analogue</strong> (think "few cube roots of unity").
                  A precise end goal is to produce either:
                </p>
                <ul>
                  <li>a theorem + constructive algorithm for which qutrit unitaries are representable in a small algebraic extension, or</li>
                  <li>a clear obstruction (why the analogue fails / needs a different ring).</li>
                </ul>

                <p>
                  This matters because these algebraic characterisations often become exact synthesis algorithms (a direct bridge from math to compilers).
                </p>

                <p>
                  <strong>State of the art:</strong>
                  qutrit exact synthesis work exists for Clifford-cyclotomic gate sets (including normal forms); the open part is
                  a crisp "cube-root" analogue with a clean ring + constructive consequences.
                  (<a href={refs.fewSquareRoots} target="_blank" rel="noopener noreferrer">arXiv:2310.14056</a>,
                  <a href={refs.qutritCyclotomic} target="_blank" rel="noopener noreferrer">arXiv:2303.13644</a>,
                  <a href={refs.singleQuditCliffordT} target="_blank" rel="noopener noreferrer">arXiv:2011.07970</a>,
                  <a href={refs.multiQutritExactSynthesis} target="_blank" rel="noopener noreferrer">arXiv:2405.08136</a>)
                </p>
              </div>
            </OfferDetailModal>

            <OfferDetailModal
              id="offer-geometric-algebra-qudits"
              labelledBy="offer-geometric-algebra-qudits-title"
            >
              <h3 id="offer-geometric-algebra-qudits-title" class="offer-modal__title">
                Geometric algebra / (generalised) Clifford algebra frameworks for qudits
              </h3>

              <div class="offer-modal__body">
                <OfferSummaryBlock offer={offerSummaryById["offer-geometric-algebra-qudits"]} />

                <p>
                  <strong>Goal:</strong> Survey and extend algebraic frameworks that represent qudit states and gates via
                  <strong>generalised Clifford algebras</strong> (or geometric-algebra-like formalisms), and connect them to modern tooling:
                  stabilizers, circuit identities, ZX/ZH-style reasoning.
                </p>

                <p class="muted">
                  This one is genuinely a "tomorrow problem" for me: I'm interested, but I'm still actively building the background to do it properly. I feel like maybe Spinors might be involved as well, I don't really have the knowledge yet.
                </p>

                <p>
                  <strong>State of the art:</strong> there is work developing algebraic calculi for multi-qudit computation grounded in generalised Clifford algebras,
                  and broad references on Clifford groups across dimensions. The open part is translating these viewpoints into practical compiler representations or
                  rewrite systems that complement ZX/ZH approaches.
                  (<a href={refs.quditCliffordAlgebras} target="_blank" rel="noopener noreferrer">arXiv:1809.07809</a>,
