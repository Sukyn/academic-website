---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameShell from '../../components/games/GameShell.astro';
import GameModeMenu from '../../components/games/GameModeMenu.astro';
import GameToolbar from '../../components/games/GameToolbar.astro';
import GameTutorial from '../../components/games/GameTutorial.astro';
import GameLeaderboard from '../../components/games/GameLeaderboard.astro';
import GameDialogs from '../../components/games/GameDialogs.astro';
import GameJsonActions from '../../components/games/GameJsonActions.astro';
import GameRoundControls from '../../components/games/GameRoundControls.astro';
import GameReviewControls from '../../components/games/GameReviewControls.astro';
import GameHoleControls from '../../components/games/GameHoleControls.astro';
import GameAutofocus from '../../components/games/GameAutofocus.astro';
import CircuitCategoryMenu from '../../components/games/CircuitCategoryMenu.astro';
import CircuitGame from '../../components/games/CircuitGame.astro';
import CategoricalCircuitGame from '../../components/games/CategoricalCircuitGame.astro';
import { LEVELS } from '../../lib/quantum-signals/puzzles.js';
import { TUTORIAL_INTRO } from '../../lib/quantum-signals/tutorial.js';
import { GATES } from '../../lib/quantum-signals/engine.js';
import { gateLabel } from '../../lib/quantum-signals/rendering.js';
import '../../styles/quantum-signals.css';
import '../../styles/signals-tutorial.css';
import SignalGateMemo from '../../components/games/SignalGateMemo.astro';
---

<BaseLayout title="Quantum signals" description="Fill the holes in a quantum circuit. Follow superposition, interference and entanglement to reach the target state.">
  <CircuitGame kind="signals">
  <GameShell>
    <a class="back" href="/games/">← Games</a>
    <h1>Quantum signals</h1>
    <div class="game-layout">
      <GameModeMenu><CircuitCategoryMenu /></GameModeMenu>
      <div class="game-content signals-game">
        <GameToolbar levels={LEVELS} />
        <GameTutorial intro={TUTORIAL_INTRO} />
        <section aria-label="Quantum signals">
          <div id="signal-stage">
          <div class="game-scroll signal-scroll" id="signal-scroll" role="region" aria-label="Circuit board. Scroll horizontally for longer circuits." tabindex="0">
            <div id="signal-board" aria-label="Circuit with gate holes"></div>
          </div>
          <div class="signal-palette" role="group" aria-label="Gate choices for the selected hole">
            {GATES.map(gate => <button class="button ghost" type="button" data-choice={gate} aria-label={gateLabel(gate)}></button>)}
            <GameHoleControls />
          </div>
          <div class="game-scroll signal-scroll signal-flow-panel" id="flow-panel" role="region" aria-label="Joint-state paths and target. Scroll vertically to explore the states." tabindex="0">
            <div class="signal-flow-layout">
              <div class="signal-flow-scroll" id="flow-scroll" role="region" aria-label="Quantum state paths. Scroll horizontally to explore the circuit columns." tabindex="0">
                <svg id="signal-flow" role="img" aria-label="Quantum state paths through the circuit"></svg>
              </div>
              <svg id="signal-target" role="img" aria-label="Target quantum state"></svg>
            </div>
          </div>
          </div>
          <SignalGateMemo />
          <GameRoundControls resultLabel="Results" />
          <div class="custom-controls" id="custom-controls" hidden>
            <label for="difficulty">Difficulty</label>
            <select id="difficulty"><option value="1">Easy</option><option value="2" selected>Medium</option><option value="3">Hard</option></select>
            <button class="button ghost" id="new-puzzle" type="button">New puzzle</button>
            <GameJsonActions />
          </div>
          <details class="advanced-features" id="advanced-features">
            <summary>Advanced</summary>
            <div class="advanced-panel">
              <GameAutofocus />
              <div class="replay-actions" id="replay-actions">
                <button class="button ghost" id="replay" type="button" hidden>See the replay</button>
                <button class="button ghost" id="share-replay" type="button" hidden>Share your replay</button>
              </div>
            </div>
            <div id="sequence" role="group" aria-label="Gate placements in chronological order"></div>
            <div id="circuit-editor-controls" hidden>
              <div class="replay-actions">
                <button class="button ghost" id="edit-circuit" type="button" aria-controls="custom-details">Edit this circuit</button>
                <button class="button ghost" id="new-circuit" type="button" aria-controls="custom-details">Start from scratch</button>
              </div>
              <div id="custom-details" hidden>
                <form id="puzzle-editor-form" class="puzzle-editor" aria-label="Circuit editor">
                  <div class="editor-dimensions">
                    <label>Wires<select id="editor-wires">{[1, 2, 3, 4].map(value => <option value={value}>{value}</option>)}</select></label>
                    <label>Columns<select id="editor-columns">{Array.from({ length: 16 }, (_, index) => <option value={index + 1}>{index + 1}</option>)}</select></label>
                  </div>
                  <div class="editor-workspace" id="editor-workspace">
                    <div class="editor-scroll" id="editor-scroll" role="region" aria-label="Circuit editor. Select a cell to change it." tabindex="0">
                      <div id="editor-board" class="editor-board" role="group" aria-label="Circuit cells"></div>
                    </div>
                    <div id="editor-menu" class="editor-menu" role="group" aria-label="Circuit cell options" hidden>
                      <div id="editor-tools" class="editor-tools"></div>
                      <div id="editor-choices" role="group" aria-label="Gates offered by this hole" hidden><div id="editor-gates"></div></div>
                    </div>
                  </div>
                  <button class="button" type="submit">Play puzzle</button>
                </form>
                <p class="message" id="custom-status" role="status"></p>
              </div>
            </div>
          </details>
          <GameReviewControls />
          <p class="message" id="status" role="status"></p>
          <noscript>Enable JavaScript to play.</noscript>
        </section>
        <GameLeaderboard completionOnly />
      </div>
    </div>
    <GameDialogs gameTitle="Quantum signals" completionOnly>
      <Fragment slot="rules">
        <p>Collect every path at the all-ones label: 1, 11, 111 or 1111. Choose a hole, then a gate. Leave holes empty to use identity when it is offered.</p>
        <p>The white wires show the circuit. Below, each lane represents a bit string. Lit paths show amplitudes splitting, moving and interfering. Black dots mean + phase; white dots mean − phase. Larger dots mean a greater chance of that result.</p>
        <p>Matching signs add; opposite signs cancel. Unlit lanes have zero amplitude. With just one surviving path, its overall sign does not change the result.</p>
        <p>Yellow squares are H, red ⊕ gates are X, and green dots are Z. Linked dots are CZ. The two CNOT choices swap the control dot and ⊕.</p>
        <p>Arrow keys move between holes. H, X, Z, I or 1–4 place gates. Right-click or Delete clears a hole; Ctrl/Cmd+Z undoes.</p>
      </Fragment>
    </GameDialogs>
  </GameShell>
  <CategoricalCircuitGame kind="signals" slot="categorical" />
  </CircuitGame>
</BaseLayout>
