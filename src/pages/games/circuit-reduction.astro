---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameShell from '../../components/games/GameShell.astro';
import GameModeMenu from '../../components/games/GameModeMenu.astro';
import GameToolbar from '../../components/games/GameToolbar.astro';
import GameTutorial from '../../components/games/GameTutorial.astro';
import GameLeaderboard from '../../components/games/GameLeaderboard.astro';
import GameDialogs from '../../components/games/GameDialogs.astro';
import GameJsonActions from '../../components/games/GameJsonActions.astro';
import GameRoundControls from '../../components/games/GameRoundControls.astro';
import GameReviewControls from '../../components/games/GameReviewControls.astro';
import { LEVELS } from '../../lib/circuit-reduction/puzzles.js';
import { RULES } from '../../lib/circuit-reduction/engine.js';
---

<BaseLayout title="Circuit simplification" description="Simplify quantum circuits to the identity using reversible rewrite rules. Play levels, custom circuits and a daily puzzle.">
  <GameShell>
    <a class="back" href="/games/">← Games</a>
    <h1>Circuit simplification</h1>
    <div class="game-layout">
      <GameModeMenu />
      <div class="game-content">
        <GameToolbar levels={LEVELS} />
        <GameTutorial />
        <section aria-label="Circuit simplification">
          <div class="circuit-heading"><p id="move-count" role="status">0 moves</p></div>
          <div class="generator-controls circuit-editor-controls" id="circuit-editor-controls" hidden>
            <label for="editor-wires">Wires</label>
            <select id="editor-wires"><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option></select>
            <button class="button" id="save-circuit" type="button">Play puzzle</button>
          </div>
          <div class="game-scroll circuit-scroll" id="circuit-scroll" role="region" aria-label="Circuit board. Scroll horizontally to see longer circuits." tabindex="0">
            <div id="circuit-board" aria-label="Quantum circuit"></div>
          </div>
          <p class="selection-note" id="selection-note" role="status" aria-live="polite"></p>
          <div class="rule-palette" role="group" aria-label="Circuit rules">
            {RULES.map(rule => <button class="button ghost rule-button" type="button" data-rule={rule.id} aria-label={rule.title} disabled></button>)}
          </div>
          <GameRoundControls>
            <button class="button ghost" id="compact-identities" type="button">Tidy</button>
          </GameRoundControls>
          <div id="daily-replay-actions" class="daily-replay-actions" hidden></div>
          <div class="replay-actions daily-replay-actions" id="replay-actions" hidden>
            <button class="button ghost" id="replay" type="button" hidden>See the replay</button>
            <button class="button ghost" id="share-score" type="button" hidden>Share your score</button>
          </div>
          <GameReviewControls />
          <p class="message" id="status" role="status"></p>
          <div class="custom-controls" id="custom-controls" hidden>
            <div class="generator-controls">
              <label for="difficulty">Difficulty</label>
              <select id="difficulty"><option value="3">Easy · 3 moves</option><option value="6" selected>Medium · 6 moves</option><option value="10">Hard · 10 moves</option><option value="14">Expert · 14 moves</option></select>
              <button class="button ghost" id="new-circuit" type="button">New circuit</button>
              <button class="button ghost" id="create-circuit" type="button">Create circuit</button>
            </div>
            <GameJsonActions />
            <p class="message" id="custom-status" role="status"></p>
          </div>
          <noscript>Enable JavaScript to play.</noscript>
        </section>
        <GameLeaderboard unit="Moves" />
      </div>
    </div>
    <GameDialogs gameTitle="Circuit simplification">
      <Fragment slot="rules">
        <p>Reduce every wire to empty slots: this is the <strong>identity circuit</strong>. Read the circuit from left to right. Use as few moves as possible.</p>
        <p>Select the cells shown in a rule, including empty slots, then choose that rule. Drag or Shift-click for a rectangle; Enter applies the sole matching rule.</p>
        <p>A yellow square (<strong>H</strong>) is a Hadamard gate, <strong>X</strong> flips a bit, and a green dot (<strong>Z</strong>) changes its phase. Linked green dots are a controlled Z; a red ⊕ endpoint turns the link into a controlled X (CNOT).</p>
        <p>Click <strong>+</strong> to add a column on every wire. Right-click an empty slot to remove it; on touch screens, hold it. <strong>Tidy</strong> removes all unnecessary gaps. Space adjustments are free and can be undone.</p>
        <p>Every rule works <strong>both ways</strong>. Introducing gates can help you simplify. Only rewrites count towards your score; moving gates through empty slots is free.</p>
        <p>Keyboard: R to reset, Backspace or Ctrl/Cmd+Z to undo, Escape to clear the selection.</p>
      </Fragment>
    </GameDialogs>
  </GameShell>
</BaseLayout>
<script>import '../../scripts/circuit-reduction.js';</script>
<style>
  .circuit-heading { display: flex; align-items: center; margin-top: 1rem; font-family: var(--font-ui); font-size: .9rem; }
  .circuit-heading p { margin: 0 0 .5rem; }
  #move-count { color: var(--color-heading); font-variant-numeric: tabular-nums; }
  .circuit-scroll { padding: 1rem .5rem; border-radius: 4px; }
  #circuit-board { position: relative; display: grid; width: max-content; margin-inline: auto; padding-inline: 22px; grid-template-columns: repeat(var(--columns, 4), 64px); grid-template-rows: repeat(var(--wires, 1), 72px); justify-items: stretch; align-items: center; font-family: var(--font-mono); user-select: none; -webkit-touch-callout: none; }
  #circuit-board :global(.circuit-wires) { position: absolute; top: 0; left: 0; pointer-events: none; }
  #circuit-board :global(.circuit-cell) { position: relative; height: 64px; width: 64px; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--color-text); cursor: pointer; padding: 0; display: grid; place-items: center; }
  #circuit-board :global(.gate-glyph) { position: relative; }
  #circuit-board :global(.circuit-cell:disabled) { opacity: 1; }
  #circuit-board :global(.circuit-cell[aria-pressed="true"]) { border-color: var(--color-accent); background: rgba(154, 217, 209, .12); }
  #circuit-board :global(.space-handle) { position: absolute; z-index: 2; width: 24px; height: 44px; transform: translate(-50%, -50%); border: 0; padding: 0; background: transparent; color: var(--color-muted); cursor: col-resize; display: grid; place-items: center; }
  #circuit-board :global(.space-glyph) { display: block; opacity: 0; transition: opacity .12s; }
  #circuit-board :global(.space-handle:hover .space-glyph), #circuit-board :global(.space-handle:focus-visible .space-glyph) { opacity: 1; color: var(--color-accent); }
  #circuit-board :global(.space-handle[data-edge] .space-glyph) { opacity: .75; }
  #circuit-board :global(.space-handle:disabled) { visibility: hidden; }
  @media (hover: none) { #circuit-board :global(.space-glyph) { opacity: .65; } }
  #circuit-board :global(button:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: -3px; }
  .selection-note { color: var(--color-muted); font-family: var(--font-ui); font-size: .8rem; margin: .25rem 0; min-height: 1.2em; }
  .rule-palette { display: grid; grid-template-columns: repeat(auto-fit, minmax(10.25rem, 1fr)); gap: .5rem; margin-top: .25rem; }
  .rule-palette .button { font-family: var(--font-ui); font-size: .85rem; padding: .4rem .6rem; min-height: 2.75rem; width: 100%; max-width: 16rem; background: var(--color-surface-2); }
  .rule-palette .button:disabled { opacity: .28; }
  .rule-palette :global(.rule-preview) { display: flex; align-items: center; justify-content: center; gap: .4rem; min-height: 24px; }
  .rule-palette :global(.rule-mini) { position: relative; display: grid; grid-template-columns: repeat(var(--mini-columns), 22px); grid-auto-rows: 22px; }
  .rule-palette :global(.rule-mini .circuit-wires) { position: absolute; inset: 0; pointer-events: none; }
  .rule-palette :global(.rule-mini .gate-glyph) { position: relative; width: 22px; height: 22px; }
  .custom-controls { margin-top: 1rem; font-family: var(--font-ui); font-size: .9rem; }
  .generator-controls { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
  .generator-controls select { min-height: 2.75rem; }
  .circuit-editor-controls { margin-bottom: .75rem; font-family: var(--font-ui); font-size: .9rem; }
  @media(max-width: 400px) { .rule-palette .button { max-width: none; font-size: .8rem; padding: .4rem; } }
</style>
