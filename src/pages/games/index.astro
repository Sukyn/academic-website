---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Games" description="Quantum games by Colin Blake.">
  <h1>Games</h1>
  <ul class="games">
    <li><h2 lang="fr">Les chevaliers du Quantique</h2><span>Coming later</span></li>
    <li><h2>Quantum golf</h2><a class="button ghost" href="/games/quantum-golf/">Play →</a></li>
  </ul>
</BaseLayout>

<style>
  .games { list-style: none; margin: 2rem 0 0; padding: 0; }
  li { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .75rem 1.5rem; margin: 0; padding: 1.5rem 0; border-top: 1px solid var(--color-border); }
  li:last-child { border-bottom: 1px solid var(--color-border); }
  h2 { margin: 0; font-size: 1.75rem; }
  span { color: var(--color-muted); font-family: var(--font-ui); font-size: .9rem; }
</style>