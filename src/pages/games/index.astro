---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { stemOutreach } from '../../data/stemOutreach';

const events = [...stemOutreach].sort((left, right) => right.date.localeCompare(left.date));
---

<BaseLayout title="Outreach & games" description="Games, classroom activities, and public workshops about quantum circuits by Colin Blake.">
  <h1>Outreach &amp; games</h1>
  <p class="prose">Games and workshops for exploring quantum circuits through play.</p>
  <ul class="games">
    <li><h2>Circuit reduction</h2><a class="button ghost" href="/games/circuit-reduction/">Play →</a></li>
    <li><h2>Quantum golf</h2><a class="button ghost" href="/games/quantum-golf/">Play →</a></li>
  </ul>

  <section class="prose events" aria-labelledby="other-events">
    <h2 id="other-events">Other events</h2>
    {events.length === 0 ? (
      <p class="muted">No events listed yet.</p>
    ) : (
      <ul class="outreach-list">
        {events.map(item => (
          <li id={item.id}>
            <p><strong>{item.title}</strong></p>
            {item.meta ? <p class="event-meta">{item.meta}</p> : null}
            <p>{item.summary}</p>
            <p class="event-links">
              {item.links.map((link, index) => (
                <>
                  {index > 0 ? <span aria-hidden="true"> | </span> : null}
                  <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                </>
              ))}
            </p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .games { list-style: none; width: fit-content; max-width: 100%; margin: 2rem auto 0; padding: 0; }
  .games > li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: clamp(1rem, 4vw, 2.5rem); margin: 0; padding: 1.5rem 0; border-top: 1px solid var(--color-border); }
  .games > li:last-child { border-bottom: 1px solid var(--color-border); }
  .games .button { min-height: 2.75rem; white-space: nowrap; }
  h2 { margin: 0; font-size: 1.75rem; }
  .events { max-width: 48rem; margin-top: 3rem; }
  .outreach-list { list-style: none; padding: 0; margin: 1.25rem 0 0; }
  .outreach-list li { margin-bottom: 1.15rem; }
  .outreach-list p { margin: .25rem 0 0; }
  .outreach-list p:first-child { margin-top: 0; }
  .event-meta, .event-links { font-size: .95rem; color: var(--color-muted); }
</style>
