---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LEVELS from '../../lib/quantum-golf/levels.json';
const scoreColumns = ['Rank', 'Player', 'Strokes'];
---

<BaseLayout title="Quantum golf" description="Reach a Bloch-sphere target using H and T gates.">
  <a class="back" href="/games/">← Games</a>
  <h1>Quantum golf</h1>

  <div class="game-layout">
    <nav class="mode-menu" aria-label="Game modes">
      <button class="button ghost" id="mode-campaign" type="button" aria-pressed="true">Levels</button>
      <button class="button ghost" id="mode-random" type="button" aria-pressed="false">Random / Custom</button>
      <div>
        <div class="daily-menu">
          <button class="button ghost" id="mode-daily" type="button" aria-pressed="false">Daily puzzle</button>
          <button class="button ghost" id="daily-toggle" type="button" aria-label="Past daily puzzles" aria-expanded="false" aria-controls="daily-archive">▾</button>
        </div>
        <div class="daily-archive" id="daily-archive" hidden>
          <label for="daily-date">Past puzzles</label>
          <select id="daily-date" disabled><option value="">Loading…</option></select>
        </div>
      </div>
      <p class="message" id="daily-status" role="status"></p>
    </nav>

    <div class="game-content">
      <div class="game-toolbar">
        <div class="level-bar" id="campaign-controls">
          <button class="button ghost" id="previous-level" type="button" aria-label="Previous level" disabled>←</button>
          <label class="sr-only" for="level">Level</label>
          <select id="level">
            {LEVELS.map(item => <option value={item.id}>{item.id} · {item.title}</option>)}
          </select>
          <button class="button ghost" id="next-level" type="button" aria-label="Next level" disabled>→</button>
        </div>
        <button class="button ghost" id="show-rules" type="button" aria-haspopup="dialog">Rules</button>
      </div>
      <div class="daily-heading" id="daily-heading" hidden>
        <p id="daily-title"></p>
        <p class="message" id="daily-note"></p>
      </div>

  <section aria-label="Quantum golf">
    <div class="sphere-view">
      <canvas id="sphere" tabindex="0" role="img" aria-label="Bloch sphere. Drag to rotate, scroll to zoom. Arrow keys rotate the view; H and T apply gates. Advanced controls change the camera and automatic following."></canvas>
      <p id="status" role="status" aria-live="polite"></p>
    </div>

    <div class="controls">
      <div class="gates">
        <button class="button gate h" id="gate-h" type="button" title="Hadamard · H">H</button>
        <button class="button gate t" id="gate-t" type="button" title="T gate · T">T</button>
      </div>
      <label class="hole" id="hole-controls" hidden>
        <span>Hole <output id="epsilon-value" for="epsilon">ε = 0.220</output></span>
        <input id="epsilon" aria-label="Hole size epsilon" type="range" min="0.03" max="0.4" step="0.005" value="0.2" />
      </label>
    </div>

    <div class="round-controls">
      <div class="free-controls" id="free-controls" hidden>
        <button class="button ghost" id="new-hole" type="button" title="New random target · N">New hole</button>
        <button class="button ghost" id="pick-target" type="button" aria-pressed="false">Pick target</button>
        <button class="button ghost" id="toggle-precision" type="button" aria-pressed="false" title="Keep the target and shrink the hole after each win">Precision</button>
        <details>
          <summary title="Set target angles">θ, φ</summary>
          <form id="coordinate-form">
            <label>θ <input id="target-theta" type="number" min="0" max="180" step="any" value="90" required aria-label="Target polar angle in degrees" />°</label>
            <label>φ <input id="target-phi" type="number" min="0" max="360" step="any" value="45" required aria-label="Target azimuth in degrees" />°</label>
            <button class="button" type="submit">Set</button>
          </form>
        </details>
      </div>
      <button class="button ghost" id="undo" type="button" title="Undo · Backspace" disabled>Undo</button>
      <button class="button ghost" id="restart" type="button" title="Restart · R">Reset</button>
      <button class="button ghost" id="toggle-trace" type="button" aria-pressed="true" title="Show gate history">Trace</button>
      <button class="button ghost" id="precision-next" type="button" hidden>Smaller hole</button>
      <button class="button ghost" id="show-results" type="button" hidden>Scores</button>
    </div>
    <details class="advanced-features" id="advanced-features">
      <summary>Advanced</summary>
      <div class="advanced-panel">
        <button class="button ghost" id="replay" type="button" hidden>See the replay</button>
        <div class="camera-panel" role="group" aria-label="View">
          <span class="camera-label">View</span>
          <button class="button ghost" id="view-target" type="button">Target</button>
          <button class="button ghost" id="toggle-follow" type="button" aria-pressed="true">Follow</button>
          <button class="button ghost" id="view-left" type="button" aria-label="Rotate view left">←</button>
          <button class="button ghost" id="view-right" type="button" aria-label="Rotate view right">→</button>
          <button class="button ghost" id="view-up" type="button" aria-label="Rotate view up">↑</button>
          <button class="button ghost" id="view-down" type="button" aria-label="Rotate view down">↓</button>
          <button class="button ghost" id="zoom-in" type="button" aria-label="Zoom in">+</button>
          <button class="button ghost" id="zoom-out" type="button" aria-label="Zoom out">−</button>
        </div>
      </div>
    </details>
    <div id="sequence" role="group" aria-label="Gate sequence in chronological order"></div>
    <div class="review-controls" id="review-controls" hidden>
      <p class="message" id="review-note" role="status"></p>
      <button class="button ghost" id="resume-round" type="button">Back to game</button>
    </div>
    <p id="best-count" role="status" hidden></p>
    <noscript>Enable JavaScript to play.</noscript>
  </section>

  <section class="leaderboard" id="leaderboard-section" aria-labelledby="leaderboard-title">
    <h2 id="leaderboard-title">Leaderboard</h2>
    <div class="ranking" tabindex="0" role="region" aria-label="Leaderboard scores">
      <table><thead><tr>{scoreColumns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody id="leaderboard-body"></tbody></table>
    </div>
    <p class="message" id="leaderboard-status" role="status"></p>
  </section>
    </div>
  </div>

  <dialog class="game-dialog rules-dialog" id="rules-dialog" aria-labelledby="rules-title">
    <button class="close-dialog" id="close-rules" type="button" aria-label="Close rules">×</button>
    <h2 id="rules-title">Rules</h2>
    <p>Start at |+⟩ = (|0⟩ + |1⟩)/√2. Reach the gold hole with as few H and T presses as possible. Drag the sphere to change your view.</p>
    <p><strong>H</strong> makes a half-turn around the diagonal between the x and z axes. <strong>T</strong> turns the point 45° around the z axis.</p>
    <p>This is approximate synthesis of a quantum state: use a small set of gates to approach a target. The hole sets the allowed error ε. A smaller hole needs a closer match.</p>
  </dialog>

  <dialog class="game-dialog win-dialog" id="win-dialog" aria-labelledby="win-title">
    <button class="close-dialog" id="close-win" type="button" aria-label="Close popup">×</button>
    <h2 id="win-title">GG</h2>
    <p id="win-summary" role="status"></p>
    <p id="win-practice" hidden>Practice completed.</p>
    <form class="score-form" id="score-form">
      <label for="player-name">Name or nickname</label>
      <input id="player-name" name="name" type="text" maxlength="48" pattern=".{1,24}" required autocomplete="nickname" autofocus />
      <button class="button" id="submit-score" type="submit">Validate</button>
    </form>
    <div id="win-results" hidden>
      <p id="player-rank" role="status"></p>
      <div class="ranking" tabindex="0" role="region" aria-label="Your leaderboard position">
        <table><thead><tr>{scoreColumns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody id="result-leaderboard-body"></tbody></table>
      </div>
    </div>
    <div class="result-actions" id="result-actions" hidden>
      <button class="button ghost" id="try-again" type="button">Try again</button>
      <button class="button" id="result-next" type="button">Next level</button>
      <button class="button" id="precision-result" type="button" hidden>Smaller hole</button>
    </div>
    <details class="advanced-features" id="result-advanced-features">
      <summary>Advanced</summary>
      <button class="button ghost" id="replay-result" type="button">See the replay</button>
    </details>
    <p class="message" id="score-status" role="status" aria-live="polite"></p>
  </dialog>
</BaseLayout>

<script>
  import '../../scripts/quantum-golf.js';
</script>

<style>
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .back { font-family: var(--font-ui); font-size: .85rem; text-decoration: none; }
  h1 { margin: .7rem 0 0; }
  output { color: var(--color-heading); font-variant-numeric: tabular-nums; }
  .game-layout { display: grid; grid-template-columns: 10.5rem minmax(0, 1fr); gap: 1.5rem; margin-top: 1rem; }
  .game-content { min-width: 0; }
  .mode-menu { display: flex; flex-direction: column; gap: .5rem; font-family: var(--font-ui); }
  .mode-menu .button { width: 100%; padding: .55rem .65rem; text-align: left; font-size: .95rem; }
  button[aria-pressed="true"] { border-color: var(--color-accent); color: var(--color-accent); }
  .daily-menu { display: grid; grid-template-columns: minmax(0, 1fr) 2rem; gap: .25rem; }
  .daily-menu #daily-toggle { padding: 0; text-align: center; }
  #daily-toggle[aria-expanded="true"] { transform: rotate(180deg); }
  .daily-archive { display: grid; gap: .4rem; padding-top: .6rem; font-size: .85rem; }
  .daily-archive select { width: 100%; max-width: none; height: 2.2rem; }
  .game-toolbar { display: flex; align-items: center; gap: .5rem; min-height: 2.5rem; font-family: var(--font-ui); }
  .level-bar { display: flex; flex: 1; align-items: center; gap: .5rem; max-width: 24rem; }
  .level-bar button, .level-bar select { height: 2.5rem; line-height: normal; }
  .level-bar button { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 2rem; padding: 0; }
  select, input[type="text"], input[type="number"] { border: 1px solid var(--color-border); border-radius: 3px; background: var(--color-surface-2); color: var(--color-text); font: inherit; padding: .35rem .5rem; }
  select { flex: 1; max-width: 18rem; min-width: 0; padding-block: 0; }
  #show-rules { height: 2.5rem; padding: 0 .7rem; line-height: normal; }
  .daily-heading { margin-top: .75rem; font-family: var(--font-ui); }
  #daily-title { margin: 0; color: var(--color-heading); font-variant-numeric: tabular-nums; }
  .sphere-view { position: relative; height: clamp(340px, 50vh, 490px); }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  #status { position: absolute; top: .7rem; left: 50%; transform: translateX(-50%); margin: 0; color: var(--color-heading); font-family: var(--font-ui); font-size: .95rem; pointer-events: none; }
  .controls, .round-controls { max-width: 37rem; margin-inline: auto; display: flex; align-items: center; gap: .7rem; }
  .controls { justify-content: space-between; padding-top: .8rem; border-top: 1px solid var(--color-border); }
  .controls:has(.hole[hidden]) { justify-content: center; }
  .gates, .free-controls { display: flex; gap: .7rem; align-items: center; }
  .gate { width: 3.3rem; height: 3.3rem; padding: 0; font-family: var(--font-mono); font-size: 1.65rem; background: transparent; }
  .h { color: #ee9f86; border-color: #ee9f8677; }
  .t { color: #b5a2ea; border-color: #b5a2ea77; }
  .hole { display: flex; flex-direction: column; gap: .35rem; width: min(55%, 17rem); font-family: var(--font-ui); font-size: .85rem; }
  .hole span { display: flex; justify-content: space-between; gap: .5rem; }
  input[type="range"] { width: 100%; accent-color: var(--color-heading); cursor: pointer; }
  .round-controls { position: relative; flex-wrap: wrap; justify-content: center; margin-top: .9rem; font-family: var(--font-ui); font-size: .85rem; }
  .round-controls .button, .advanced-features .button, .review-controls .button { padding: .35rem .65rem; font-size: .85rem; }
  .round-controls .button { background: transparent; }
  summary { cursor: pointer; color: var(--color-muted); }
  .advanced-features { max-width: 37rem; margin: .7rem auto 0; font-family: var(--font-ui); font-size: .85rem; text-align: center; }
  .advanced-features > summary { width: fit-content; min-height: 2rem; margin-inline: auto; padding: .35rem .5rem; }
  .advanced-panel { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .7rem; margin-top: .6rem; }
  .advanced-features .button { min-height: 2rem; min-width: 2rem; }
  .camera-panel { width: 12rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; }
  .camera-panel .button { padding: .25rem; }
  .camera-label { grid-column: 1 / -1; color: var(--color-muted); }
  #view-target, #toggle-follow, #zoom-in, #zoom-out { grid-column: span 2; }
  #coordinate-form { position: absolute; bottom: 2rem; right: 0; z-index: 2; display: flex; align-items: center; gap: .7rem; padding: .75rem; border: 1px solid var(--color-border); border-radius: 3px; background: var(--color-surface); }
  #coordinate-form label { display: flex; gap: .25rem; align-items: center; }
  input[type="number"] { width: 4.2rem; padding: .25rem; }
  #sequence, #best-count { max-width: 37rem; margin: .9rem auto 0; min-height: 1.5em; text-align: center; overflow-wrap: anywhere; font-family: var(--font-mono); color: var(--color-muted); font-size: .8rem; }
  #sequence { display: flex; flex-wrap: wrap; justify-content: center; gap: .2rem; max-height: 8rem; overflow: auto; }
  #sequence :global(button) { min-width: 2rem; min-height: 2rem; padding: .2rem .35rem; border: 1px solid transparent; border-radius: 3px; background: transparent; color: inherit; font: inherit; cursor: pointer; }
  #sequence :global(button[aria-current="step"]) { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-surface-2); }
  .review-controls { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: .7rem; margin-top: .6rem; font-family: var(--font-ui); }
  .review-controls .message { margin: 0; }
  .leaderboard { max-width: 37rem; margin: 1.4rem auto 0; font-family: var(--font-ui); }
  h2 { font-size: 1.4rem; margin: 0 0 .7rem; }
  .ranking { max-height: 16rem; overflow: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  table :global(th), table :global(td) { text-align: left; padding: .4rem .65rem; border-bottom: 1px solid var(--color-border); }
  table :global(th) { color: var(--color-muted); font-weight: 400; }
  table :global(th:last-child), table :global(td:last-child) { text-align: right; font-variant-numeric: tabular-nums; }
  table :global(.benchmark) { color: var(--color-heading); font-weight: 600; }
  table :global(.current-player) { background: var(--color-surface-2); color: var(--color-heading); font-weight: 600; }
  .score-form { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; font-size: .9rem; }
  .score-form label { width: 100%; }
  .score-form input { flex: 1; min-width: 8rem; width: 12rem; }
  .score-form button { font-size: .9rem; padding: .4rem .65rem; }
  .message { margin: .5rem 0 0; color: var(--color-muted); font-size: .85rem; }
  .message:empty { display: none; }
  .game-dialog { width: min(34rem, calc(100% - 2rem)); max-height: 85vh; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: 4px; background: var(--color-surface); color: var(--color-text); font-family: var(--font-ui); }
  .game-dialog::backdrop { background: rgba(3, 12, 9, .8); }
  .rules-dialog p { margin: .8rem 0 0; line-height: 1.55; }
  #win-title { text-align: center; margin: 0 0 .75rem; font-size: 2.4rem; line-height: 1; }
  #win-summary { margin: 0 0 1rem; text-align: center; font-variant-numeric: tabular-nums; }
  .close-dialog { position: absolute; top: .4rem; right: .6rem; border: 0; background: transparent; color: var(--color-muted); font-size: 1.6rem; cursor: pointer; }
  #player-rank { margin: 0 0 1rem; text-align: center; color: var(--color-heading); font-variant-numeric: tabular-nums; }
  .win-dialog .ranking { max-height: 23rem; }
  .win-dialog table { font-size: .85rem; line-height: 1.35; }
  .win-dialog table :global(th), .win-dialog table :global(td) { padding: .25rem .5rem; }
  .result-actions { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .7rem; margin-top: 1.2rem; }
  button:disabled { opacity: .35; cursor: default; }
  button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible, canvas:focus-visible, .ranking:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @media (max-width: 760px) {
    .game-layout { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .mode-menu { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
    .mode-menu .button { padding: .4rem .5rem; font-size: .85rem; }
    .mode-menu #daily-status { grid-column: 1 / -1; }
    .daily-menu { grid-template-columns: minmax(0, 1fr) 2.75rem; }
    .daily-archive { font-size: .8rem; }
    .game-layout .button, .game-dialog button, #sequence :global(button) { min-width: 2.75rem; min-height: 2.75rem; }
    .advanced-features > summary, .free-controls summary { min-height: 2.75rem; padding-block: .5rem; }
    .level-bar { min-width: 0; }
    .level-bar select, #show-rules { height: 2.75rem; }
    .daily-archive select, input[type="number"], .score-form input { min-height: 2.75rem; font-size: 1rem; }
    .camera-panel { width: min(100%, 16rem); }
    .game-dialog { padding: 1rem; max-height: 90dvh; }
    .close-dialog { width: 2.75rem; top: 0; right: 0; }
    .score-form input { min-width: 0; }
    table :global(td:nth-child(2)) { overflow-wrap: anywhere; }
  }
  @media (max-width: 600px) {
    :global(main.container) { padding-top: 1rem; }
    .game-layout { gap: .75rem; margin-top: .75rem; }
    .mode-menu { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mode-menu > div { grid-column: 1 / -1; }
    .mode-menu .button { font-size: .95rem; text-align: center; }
    .game-toolbar, .level-bar { gap: .4rem; }
    #show-rules { margin-left: auto; }
    .sphere-view { height: clamp(250px, 75vw, 320px); }
    .controls { flex-direction: column; gap: .6rem; }
    .gate { width: 4.5rem; height: 3.5rem; }
    .hole { width: 100%; }
    input[type="range"] { min-height: 2.75rem; }
    .round-controls { gap: .5rem; }
    .free-controls { flex-basis: 100%; order: 1; flex-wrap: wrap; justify-content: center; gap: .5rem; }
    .free-controls details { width: 100%; }
    #coordinate-form { position: static; flex-wrap: wrap; justify-content: center; gap: .5rem; padding: .5rem; }
    #sequence:empty { display: none; }
  }
</style>
