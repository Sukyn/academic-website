---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LEVELS from '../../lib/quantum-golf/levels.json';
import GameShell from '../../components/games/GameShell.astro';
import GameModeMenu from '../../components/games/GameModeMenu.astro';
import GameToolbar from '../../components/games/GameToolbar.astro';
import GameLeaderboard from '../../components/games/GameLeaderboard.astro';
import GameDialogs from '../../components/games/GameDialogs.astro';
---

<BaseLayout title="Quantum golf" description="Reach a Bloch-sphere target using H and T gates.">
  <GameShell>
  <a class="back" href="/games/">← Games</a>
  <h1>Quantum golf</h1>

  <div class="game-layout">
    <GameModeMenu />

    <div class="game-content">
      <GameToolbar levels={LEVELS} />

  <section aria-label="Quantum golf">
    <div class="sphere-view">
      <canvas id="sphere" tabindex="0" role="img" aria-label="Bloch sphere. Drag to rotate, scroll to zoom. Arrow keys rotate the view; H and T apply gates. Advanced controls change the camera and automatic following."></canvas>
      <p id="status" role="status" aria-live="polite"></p>
    </div>

    <div class="controls">
      <div class="gates">
        <button class="button gate h" id="gate-h" type="button" title="Hadamard · H">H</button>
        <button class="button gate t" id="gate-t" type="button" title="T gate · T">T</button>
      </div>
      <label class="hole" id="hole-controls" hidden>
        <span>Hole <output id="epsilon-value" for="epsilon">ε = 0.220</output></span>
        <input id="epsilon" aria-label="Hole size epsilon" type="range" min="0.03" max="0.4" step="0.005" value="0.2" />
      </label>
    </div>

    <div class="round-controls">
      <div class="free-controls" id="free-controls" hidden>
        <button class="button ghost" id="new-hole" type="button" title="New random target · N">New hole</button>
        <button class="button ghost" id="pick-target" type="button" aria-pressed="false">Pick target</button>
        <button class="button ghost" id="toggle-precision" type="button" aria-pressed="false" title="Keep the target and shrink the hole after each win">Precision</button>
        <details>
          <summary title="Set target angles">θ, φ</summary>
          <form id="coordinate-form">
            <label>θ <input id="target-theta" type="number" min="0" max="180" step="any" value="90" required aria-label="Target polar angle in degrees" />°</label>
            <label>φ <input id="target-phi" type="number" min="0" max="360" step="any" value="45" required aria-label="Target azimuth in degrees" />°</label>
            <button class="button" type="submit">Set</button>
          </form>
        </details>
      </div>
      <button class="button ghost" id="undo" type="button" title="Undo · Backspace" disabled>Undo</button>
      <button class="button ghost" id="restart" type="button" title="Restart · R">Reset</button>
      <button class="button ghost" id="toggle-trace" type="button" aria-pressed="true" title="Show gate history">Trace</button>
      <button class="button ghost" id="precision-next" type="button" hidden>Smaller hole</button>
      <button class="button ghost" id="show-results" type="button" hidden>Scores</button>
    </div>
    <div id="daily-replay-actions" class="daily-replay-actions" hidden></div>
    <details class="advanced-features" id="advanced-features">
      <summary>Advanced</summary>
      <div class="advanced-panel">
        <div class="replay-actions" id="replay-actions">
          <button class="button ghost" id="replay" type="button" hidden>See the replay</button>
          <button class="button ghost" id="share-score" type="button" hidden>Share your score</button>
        </div>
        <div class="camera-panel" role="group" aria-label="View">
          <span class="camera-label">View</span>
          <button class="button ghost" id="view-target" type="button">Target</button>
          <button class="button ghost" id="toggle-follow" type="button" aria-pressed="true">Follow</button>
          <button class="button ghost" id="view-left" type="button" aria-label="Rotate view left">←</button>
          <button class="button ghost" id="view-right" type="button" aria-label="Rotate view right">→</button>
          <button class="button ghost" id="view-up" type="button" aria-label="Rotate view up">↑</button>
          <button class="button ghost" id="view-down" type="button" aria-label="Rotate view down">↓</button>
          <button class="button ghost" id="zoom-in" type="button" aria-label="Zoom in">+</button>
          <button class="button ghost" id="zoom-out" type="button" aria-label="Zoom out">−</button>
        </div>
      </div>
    </details>
    <div id="sequence" role="group" aria-label="Gate sequence in chronological order"></div>
    <div class="review-controls" id="review-controls" hidden>
      <p class="message" id="review-note" role="status"></p>
      <button class="button ghost" id="resume-round" type="button">Back to game</button>
    </div>
    <p id="best-count" role="status" hidden></p>
    <noscript>Enable JavaScript to play.</noscript>
  </section>

  <GameLeaderboard unit="Strokes" />
    </div>
  </div>

  <GameDialogs gameTitle="Quantum golf" unit="Strokes" filename="quantum-golf.gif">
    <Fragment slot="rules">
      <p>Start at |+⟩ = (|0⟩ + |1⟩)/√2. Reach the gold hole with as few H and T presses as possible. Drag the sphere to change your view.</p>
    <p><strong>H</strong> makes a half-turn around the diagonal between the x and z axes. <strong>T</strong> turns the point 45° around the z axis.</p>
    <p>This is approximate synthesis of a quantum state: use a small set of gates to approach a target. The hole sets the allowed error ε. A smaller hole needs a closer match.</p>
    </Fragment>
    <button slot="result-actions" class="button" id="precision-result" type="button" hidden>Smaller hole</button>
  </GameDialogs>
  </GameShell>
</BaseLayout>

<script>
  import '../../scripts/quantum-golf.js';
</script>

<style>
  input[type="number"] { border: 1px solid var(--color-border); border-radius: 3px; background: var(--color-surface-2); color: var(--color-text); font: inherit; padding: .35rem .5rem; }
  .sphere-view { position: relative; height: clamp(340px, 50vh, 490px); }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  #status { position: absolute; top: .7rem; left: 50%; transform: translateX(-50%); margin: 0; color: var(--color-heading); font-family: var(--font-ui); font-size: .95rem; pointer-events: none; }
  .controls { max-width: 37rem; margin-inline: auto; display: flex; align-items: center; gap: .7rem; }
  .controls { justify-content: space-between; padding-top: .8rem; border-top: 1px solid var(--color-border); }
  .controls:has(.hole[hidden]) { justify-content: center; }
  .gates, .free-controls { display: flex; gap: .7rem; align-items: center; }
  .gate { width: 3.3rem; height: 3.3rem; padding: 0; font-family: var(--font-mono); font-size: 1.65rem; background: transparent; }
  .h { color: #ee9f86; border-color: #ee9f8677; }
  .t { color: #b5a2ea; border-color: #b5a2ea77; }
  .hole { display: flex; flex-direction: column; gap: .35rem; width: min(55%, 17rem); font-family: var(--font-ui); font-size: .85rem; }
  .hole span { display: flex; justify-content: space-between; gap: .5rem; }
  input[type="range"] { width: 100%; accent-color: var(--color-heading); cursor: pointer; }
  .camera-panel { width: 12rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: .4rem; }
  .camera-panel .button { padding: .25rem; }
  .camera-label { grid-column: 1 / -1; color: var(--color-muted); }
  #view-target, #toggle-follow, #zoom-in, #zoom-out { grid-column: span 2; }
  #coordinate-form { position: absolute; bottom: 2rem; right: 0; z-index: 2; display: flex; align-items: center; gap: .7rem; padding: .75rem; border: 1px solid var(--color-border); border-radius: 3px; background: var(--color-surface); }
  #coordinate-form label { display: flex; gap: .25rem; align-items: center; }
  input[type="number"] { width: 4.2rem; padding: .25rem; }
  canvas:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @media (max-width: 760px) {
  .free-controls summary { min-height: 2.75rem; padding-block: .5rem; }
  input[type="number"] { min-height: 2.75rem; font-size: 1rem; }
  .camera-panel { width: min(100%, 16rem); }
  }
  @media (max-width: 600px) {
  .sphere-view { height: clamp(250px, 75vw, 320px); }
  .controls { flex-direction: column; gap: .6rem; }
  .gate { width: 4.5rem; height: 3.5rem; }
  .hole { width: 100%; }
  input[type="range"] { min-height: 2.75rem; }
  .free-controls { flex-basis: 100%; order: 1; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  .free-controls details { width: 100%; }
  #coordinate-form { position: static; flex-wrap: wrap; justify-content: center; gap: .5rem; padding: .5rem; }
  }
</style>
