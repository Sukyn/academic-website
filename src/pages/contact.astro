---
import { profileLinks, siteProfile } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Email, profiles, and ways to get in touch about research and collaborations."
>
  <section class="prose">
    <h1>Contact</h1>

    <p>
      If you want to talk about qudits, circuit rewriting, diagrammatic methods,
      or possible collaborations, email is the fastest route.
    </p>

    <p>
      For student projects, please involve a formal supervisor; I do not
      supervise independently.
    </p>

    <h2>Email</h2>
    <p class="contact-mail">
      <a href={`mailto:${siteProfile.email}`}>{siteProfile.email}</a>
    </p>
    <p class="muted">{siteProfile.affiliation}</p>

    <h2>Useful links</h2>
    <ul>
      {profileLinks.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .contact-mail {
      font-size: 1.1rem;
      font-weight: 700;
    }
  </style>
</BaseLayout>
