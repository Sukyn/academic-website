---
import ScratchProfileCard from "../components/ScratchProfileCard.astro";
import { profileLinks, siteProfile } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const profileFacts = [
  {
    label: "Affiliation",
    value: siteProfile.affiliation,
  },
  {
    label: "Availability",
    value: "Open to research discussion and collaboration, but not currently available for formal student supervision.",
  },
];
---

<BaseLayout
  title="Home"
  description="Quantum computing research, expository notes, and collaboration ideas by Colin Blake."
  showWallpaper={true}
>
  <section class="hero">
    <div class="hero-main">
      <p class="eyebrow">Qudit circuit theory, rewriting, and compilation</p>
      <h1>Colin Blake</h1>
      <p class="hero-role">
        PhD student in quantum computing at Inria's MOCQUA team.
      </p>

      <p class="hero-copy">
        I work on <strong>equational theories for quantum circuits</strong>:
        which identities are enough, how to make them uniform in the
        dimension, and how those identities turn into normal forms or rewrite
        systems.
      </p>

      <p class="hero-copy hero-copy--muted">
        Most of my current work sits around qudits, phase-affine fragments,
        controlled structure, and the algebra underneath compilation.
      </p>

      <p class="hero-copy hero-copy--muted">
        I am currently a PhD student, so I am not in a position to supervise students on my own. The ideas on this
        site are mostly pointers for other researchers, or for students who already have formal supervision on their
        side.
      </p>

      <div class="button-row">
        <a class="button primary" href="/publications">See papers</a>
        <a class="button ghost" href="/offers">Research ideas</a>
        <a class="button ghost" href="/contact">Email me</a>
      </div>
    </div>

    <aside class="hero-side" aria-label="Research profile">
      <ScratchProfileCard />

      <article class="profile-card">
        <p class="eyebrow">Research profile</p>
        <dl class="profile-list">
          {profileFacts.map((fact) => (
            <div class="profile-row">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>

        <div class="button-row profile-links">
          {profileLinks.slice(0, 2).map((link) => (
            <a
              class="button ghost"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          ))}
          <a class="button ghost" href="/about">About</a>
        </div>
      </article>
    </aside>
  </section>

  <style>
    .hero {
      display: grid;
      gap: 1.25rem;
      align-items: start;
      padding: clamp(1rem, 3vw, 2rem);
      border: 1px solid var(--color-border);
      border-radius: 1.5rem;
      background: linear-gradient(
        145deg,
        var(--color-surface-2),
        color-mix(in srgb, var(--color-surface) 82%, transparent)
      );
      box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    }

    .hero-main {
      min-width: 0;
    }

    .hero-side {
      display: grid;
      gap: 1rem;
      align-items: start;
    }

    .eyebrow {
      margin-bottom: 0.6rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .hero-role {
      margin-bottom: 0.75rem;
      font-size: 1.15rem;
      font-weight: 600;
    }

    .hero-copy {
      max-width: 62ch;
      font-size: 1.05rem;
    }

    .hero-copy--muted {
      color: var(--color-muted);
    }

    .profile-card {
      padding: 1.1rem;
      border: 1px solid var(--color-border);
      border-radius: 1.15rem;
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    }

    .profile-list {
      display: grid;
      gap: 0.85rem;
      margin: 0;
    }

    .profile-row {
      display: grid;
      gap: 0.2rem;
    }

    .profile-row dt {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-muted);
    }

    .profile-row dd {
      margin: 0;
    }

    .profile-links {
      margin-top: 1rem;
    }

    @media (min-width: 980px) {
      .hero {
        grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.95fr);
      }
    }
  </style>
</BaseLayout>
