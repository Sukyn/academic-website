---
import ScratchProfileCard from "../components/ScratchProfileCard.astro";
import { profileLinks, siteProfile } from "../data/site";
import { publicationNotesById } from "../data/publicationNotes";
import { parseBibtexToPubs } from "../lib/bibtex";
import bibtex from "../content/publications.bibtex?raw";
import BaseLayout from "../layouts/BaseLayout.astro";

const highlights = parseBibtexToPubs(bibtex).filter(publication =>
  publication.id === "blake:LIPIcs.MFCS.2026.6" || publication.id === "blake:LIPIcs.FSCD.2026.6");

const namesakes = [
  { role: "the hockey player", href: "https://www.eliteprospects.com/player/240742/colin-blake" },
  { role: "the production designer", href: "https://www.imdb.com/name/nm2072003/" },
  { role: "the American football player", href: "https://www.sports-reference.com/cfb/players/colin-blake-1.html" },
  { role: "the baseball pitcher", href: "https://scsuowls.com/sports/baseball/roster/colin-blake/11534" },
  { role: "the motion designer", href: "https://www.colinblake.co.uk/" },
  { role: "the ambient musician", href: "https://weareallghosts.bandcamp.com/album/all-is-bright-2023-waag-com006" },
  { role: "the molecular biophysicist", href: "https://www.nature.com/articles/306535a0" },
  { role: "the membrane researcher", href: "https://kusoglulab.lbl.gov/publications?author=Colin+Blake" },
  { role: "the applications engineer", href: "https://www.linkedin.com/in/colinblake" },
  { role: "the psychometrist", href: "https://za.linkedin.com/in/cbpractice" },
  { role: "the vicar", href: "https://zephaniah.org.uk/2017/11/08/sparks-of-hope-the-christmas-resource/" },
  { role: "the snowboard coach", href: "https://www.generalassemb.ly/instructors/colin-blake/4754" },
  { role: "the film festival organiser", href: "https://www.alamedafilmfest.com/about" },
];
---

<BaseLayout
  title="Home"
  description="Quantum computing research, publications, and collaboration ideas by Colin Blake."
>
  <section class="prose home-page">
    <div class="intro">
      <div class="intro-copy">
        <h1>{siteProfile.name}</h1>

        <p class="lead">PhD student in quantum computing at Inria's MOCQUA team.</p>

        <p>
          I study <strong>equations and normal forms for quantum circuits</strong>,
          especially qudits: how to prove circuits equivalent and turn those
          proofs into rewriting methods.
        </p>
      </div>

      <aside class="intro-photo" aria-label="Profile picture">
        <ScratchProfileCard />
      </aside>
    </div>

    <p class="home-links">
      <a href="/profile/colin-blake-cv.pdf" download>CV (PDF)</a>
      <a href="/profile/research-overview.pdf" download>Research overview (PDF)</a>
      <a href="/publications">Publications</a>
      <a href="/contact">Contact</a>
    </p>

    <h2>Selected work</h2>
    <ul class="highlights">
      {highlights.map(publication => (
        <li>
          <a href={`/publications#${publication.id}`}>{publication.title}</a>
          <p>{publicationNotesById[publication.id].status}</p>
        </li>
      ))}
    </ul>

    <p class="home-links">
      {profileLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
      ))}
    </p>

    <aside class="disambiguation" aria-labelledby="disambiguation-title">
      <h2 id="disambiguation-title">Disambiguation</h2>

      <p>&quot;Colin Blake&quot; is not a primary key. I am not:</p>
      <ul>
        {namesakes.map(person => (
          <li>
            <a href={person.href} target="_blank" rel="noopener noreferrer">Colin Blake, {person.role}</a>.
          </li>
        ))}
      </ul>

      <p>(P.S. Please let me know if you know of any other Colin Blakes.)</p>

      <p>
        For further information on the wider Blake line, I can only recommend
        the impeccably reliable
        <a
          href="https://seanceofblakemanor.wiki.gg/wiki/Blake_Family"
          target="_blank"
          rel="noopener noreferrer"
        >Blake Family records from <em>The Seance at Blake Manor</em></a>.
      </p>

      <figure class="colin-barbu" lang="fr">
        <a
          href="https://commons.wikimedia.org/wiki/File:Dendrortyx_barbatus_-_A_monograph_of_the_Odontophorin%C3%A6,_or,_Partridges_of_America.jpg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/images/colin-barbu.webp"
            alt="Deux Colins barbus, illustration de John Gould et Henry Constantine Richter"
            width="480"
            height="316"
            loading="lazy"
            decoding="async"
          />
        </a>
        <figcaption>
          <blockquote cite="https://fr.wikipedia.org/wiki/Colin_barbu">
            <p>« Le Colin barbu (<i>Dendrortyx barbatus</i>) est une espèce d'oiseau
              galliforme appartenant à la famille des Odontophoridae. »</p>
          </blockquote>
          <cite><a href="https://fr.wikipedia.org/wiki/Colin_barbu" target="_blank" rel="noopener noreferrer">Wikipédia</a></cite>
        </figcaption>
      </figure>
    </aside>
  </section>

  <style>
    .home-page {
      max-width: 48rem;
    }

    .intro {
      display: grid;
      gap: 1rem;
      align-items: start;
    }

    .intro-copy {
      min-width: 0;
    }

    .intro-photo {
      display: flex;
      justify-content: center;
      margin: 0 0 0.5rem;
    }

    .home-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      margin: 1.25rem 0 1.5rem;
      font-family: var(--font-mono);
      font-size: 0.88rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .highlights li {
      margin-bottom: 1rem;
    }

    .highlights p {
      margin: 0.25rem 0 0;
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    @media (min-width: 760px) {
      .intro {
        grid-template-columns: minmax(0, 1fr) 11rem;
        gap: 1.5rem;
      }

      .intro-photo {
        justify-content: end;
        margin: 0;
        padding-top: 0.25rem;
      }
    }

    .disambiguation {
      margin: 1.5rem 0;
      padding: 1rem 1.1rem;
      border: 1px solid var(--color-border);
      border-left: 3px solid var(--color-accent);
      border-radius: 0.7rem;
      background:
        linear-gradient(135deg, rgba(15, 102, 124, 0.06), transparent 72%),
        var(--color-surface);
    }

    .disambiguation h2 {
      margin-top: 0;
      font-size: clamp(1.25rem, 2.4vw, 1.45rem);
    }

    .disambiguation p:last-child {
      margin-bottom: 0;
    }

    .colin-barbu {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 1.25rem 0 0;
      font-size: 0.9rem;
    }

    .colin-barbu > a {
      flex: 0 0 9rem;
    }

    .colin-barbu img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 0.3rem;
    }

    .colin-barbu blockquote {
      margin: 0 0 0.35rem;
    }

    .colin-barbu cite {
      font-size: 0.8rem;
      font-style: normal;
    }

    @media (max-width: 480px) {
      .colin-barbu {
        flex-direction: column;
        align-items: flex-start;
      }

      .colin-barbu > a {
        flex-basis: auto;
        width: 9rem;
      }
    }
  </style>
</BaseLayout>
