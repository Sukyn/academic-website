---
import ScratchProfileCard from "../components/ScratchProfileCard.astro";
import { profileLinks, siteProfile } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const profileFacts = [
  {
    label: "Affiliation",
    value: siteProfile.affiliation,
  },
  {
    label: "Research area",
    value: siteProfile.researchArea,
  },
  {
    label: "Availability",
    value: "Open to research discussion and collaboration, but not currently available for formal student supervision.",
  },
];

const currentTopics = [
  "equational theories for quantum circuits",
  "qudit fragments and dimension-uniform presentations",
  "normal forms and rewriting methods for compilation",
];
---

<BaseLayout
  title="Home"
  description="Quantum computing research, publications, and collaboration ideas by Colin Blake."
>
  <section class="prose home-page">
    <div class="intro">
      <div class="intro-copy">
        <h1>Colin Blake</h1>

        <p class="lead">PhD student in quantum computing at Inria's MOCQUA team.</p>

        <p>
          I work on <strong>equational theories for quantum circuits</strong>:
          which identities are enough, how to make them uniform in the dimension,
          and how those identities turn into normal forms or rewrite systems.
        </p>

        <p>
          Most of my current work sits around qudits, phase-affine fragments,
          controlled structure, and the algebra underneath compilation.
        </p>

        <p>
          I am currently a PhD student, so I am not in a position to supervise
          students on my own. I am still happy to discuss related research with
          people who already have formal supervision on their side.
        </p>
      </div>

      <aside class="intro-photo" aria-label="Profile picture">
        <ScratchProfileCard />
      </aside>
    </div>

    <p class="home-links">
      <a href="/publications">Publications</a>
      <span aria-hidden="true"> | </span>
      <a href="/contact">Contact</a>
    </p>

    <h2>Current topics</h2>
    <ul>
      {currentTopics.map((topic) => (
        <li>{topic}</li>
      ))}
    </ul>

    <h2>Research profile</h2>
    <dl class="profile-list">
      {profileFacts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>

    <h2>External profiles</h2>
    <ul>
      {profileLinks.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .home-page {
      max-width: 48rem;
    }

    .intro {
      display: grid;
      gap: 1rem;
      align-items: start;
    }

    .intro-copy {
      min-width: 0;
    }

    .intro-photo {
      display: flex;
      justify-content: center;
      margin: 0 0 0.5rem;
    }

    .home-links {
      margin: 1.25rem 0 1.5rem;
      font-family: var(--font-mono);
      font-size: 0.88rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .profile-list {
      margin: 1rem 0 0;
    }

    .profile-list div {
      padding: 0.6rem 0;
      border-top: 1px solid var(--color-border);
    }

    .profile-list div:last-child {
      border-bottom: 1px solid var(--color-border);
    }

    .profile-list dt {
      margin-bottom: 0.2rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--color-accent);
    }

    .profile-list dd {
      margin: 0;
    }

    @media (min-width: 760px) {
      .intro {
        grid-template-columns: minmax(0, 1fr) 11rem;
        gap: 1.5rem;
      }

      .intro-photo {
        justify-content: end;
        margin: 0;
        padding-top: 0.25rem;
      }
    }
  </style>
</BaseLayout>
