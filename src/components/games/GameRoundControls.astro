---
interface Props { resultLabel?: string }
const { resultLabel = 'Scores' } = Astro.props;
---

<div class="round-controls">
  <slot name="before" />
  <button class="button ghost" id="undo" type="button" aria-keyshortcuts="Control+Z Meta+Z Backspace" disabled>Undo</button>
  <button class="button ghost" id="restart" type="button" aria-keyshortcuts="R">Reset</button>
  <slot />
  <button class="button ghost" id="show-results" type="button" hidden>{resultLabel}</button>
</div>
