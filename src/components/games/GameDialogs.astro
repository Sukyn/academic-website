---
import GamePuzzleJsonDialog from './GamePuzzleJsonDialog.astro';
import GameRulesDialog from './GameRulesDialog.astro';
import GameResultDialog from './GameResultDialog.astro';
interface Props { gameTitle: string; unit?: string; completionOnly?: boolean }
const { gameTitle, unit = 'Moves', completionOnly = false } = Astro.props;
const ranked = !completionOnly;
const shareTitle = ranked ? 'Share your score' : 'Share your replay';
---

<GameRulesDialog>
  <slot name="rules" />
</GameRulesDialog>

<GamePuzzleJsonDialog />

<GameResultDialog unit={unit} completionOnly={completionOnly}>
  <Fragment slot="result-actions"><slot name="result-actions" /></Fragment>
</GameResultDialog>

<dialog class="game-dialog share-dialog" id="share-dialog" aria-labelledby="share-title">
  <button class="close-dialog" id="close-share" type="button" aria-label="Close sharing">×</button>
  <h2 id="share-title">{shareTitle}</h2>
  <p class="message" id="share-status" role="status"></p>
  <img id="share-preview" hidden alt={`Replay of your ${gameTitle.toLowerCase()} ${ranked ? 'score' : 'circuit'}`} />
  <div class="share-actions">
    <button class="button" id="copy-gif" type="button" disabled>Copy image</button>
    <button class="button ghost" id="download-gif" type="button">Download the replay</button>
  </div>
</dialog>
