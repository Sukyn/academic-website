---
interface Props { kind: 'simplification' | 'signals' }
const { kind } = Astro.props;
---

<div data-circuit-game={kind}>
  <div data-pro-game><slot /></div>
  <template data-categorical-template><slot name="categorical" /></template>
</div>

<script>import '../../scripts/circuit-game.js';</script>

<style>
  @media (max-width: 600px) {
    [data-circuit-game="simplification"] :global(.circuit-actions) { display: flex; flex-direction: column; }
    [data-circuit-game="simplification"] :global(.circuit-actions > .round-controls) { order: -1; margin: .5rem 0 .75rem; }
  }
</style>
