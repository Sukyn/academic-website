---
import '../../styles/games.css';
import DailyGameLinks from './DailyGameLinks.astro';
interface Props { daily?: boolean }
const { daily = true } = Astro.props;
---

<div class="quantum-game">
  {daily && <DailyGameLinks current={Astro.url.pathname.split('/').filter(Boolean).at(-1)} hidden />}
  <slot />
</div>
