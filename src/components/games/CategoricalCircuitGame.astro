---
import GameShell from './GameShell.astro';
import GameModeMenu from './GameModeMenu.astro';
import GameToolbar from './GameToolbar.astro';
import GameTutorial from './GameTutorial.astro';
import GameJsonActions from './GameJsonActions.astro';
import GamePuzzleJsonDialog from './GamePuzzleJsonDialog.astro';
import GameReviewControls from './GameReviewControls.astro';
import GameRoundControls from './GameRoundControls.astro';
import GameRulesDialog from './GameRulesDialog.astro';
import GameWinDialog from './GameWinDialog.astro';
import GameHoleControls from './GameHoleControls.astro';
import GameAutofocus from './GameAutofocus.astro';
import CircuitCategoryMenu from './CircuitCategoryMenu.astro';
import '../../styles/quantum-signals.css';
import '../../styles/categorical-circuits.css';

interface Props { kind: 'simplification' | 'signals' }
const { kind } = Astro.props;
const signals = kind === 'signals';
const title = signals ? 'Quantum signals' : 'Circuit simplification';
const original = signals ? '/games/quantum-signals/' : '/games/circuit-reduction/';
const tools = [
  { value: 'select', label: 'Select' },
  { value: 'H', label: 'H' },
  { value: 'X', label: 'X' },
  { value: 'Z', label: 'Z' },
  { value: 'SWAP', label: 'SWAP' },
  { value: 'erase', label: 'Erase' },
  { value: 'control', label: 'Control' },
  { value: 'hole', label: 'Hole' },
];
---

<div id="categorical-game" class="categorical-game" data-categorical-game data-kind={kind}>
  <GameShell daily={false}>
    <a class="back" href={original}>← {title}</a>
    <h1>{title} · Advanced</h1>
    <div class="game-layout">
      <GameModeMenu daily={false}><CircuitCategoryMenu kind={kind} advanced /></GameModeMenu>
      <div class="game-content">
        <GameToolbar levels={[]} daily={false} />
        <GameTutorial intro={signals ? 'Fill the holes to match the target paths.' : 'Reach the identity using swaps and circuit equations.'} />
        <section aria-label={`${title}, advanced circuits`}>
          <p id="move-count" class="categorical-count" role="status" hidden={signals}>0 moves</p>
          <div class="game-scroll categorical-scroll" id="categorical-scroll" role="region" aria-label="Circuit board. Scroll horizontally to explore longer circuits." tabindex="0">
            <div id="categorical-board" role="group" aria-label="Quantum circuit"></div>
          </div>
          <div id="rule-list" class="categorical-rule-list" role="group" aria-label="Circuit rewrite rules" hidden={signals}></div>
          <div class="signal-palette" hidden={!signals}>
            <div id="gate-palette" class="categorical-gate-palette" role="group" aria-label="Gate choices for the selected hole"></div>
            {signals && <GameHoleControls />}
          </div>
          <div class="game-scroll signal-scroll signal-flow-panel" id="flow-panel" role="region" aria-label="Joint-state paths and target. Scroll vertically to explore the states." tabindex="0" hidden={!signals}>
            <div class="signal-flow-layout">
              <div class="signal-flow-scroll" id="flow-scroll" role="region" aria-label="Quantum state paths. Scroll horizontally to explore circuit columns." tabindex="0">
                <svg id="signal-flow" role="img" aria-label="Quantum state paths through the circuit"></svg>
              </div>
              <svg id="signal-target" role="img" aria-label="Target quantum state"></svg>
            </div>
          </div>
          <GameRoundControls results={false}>
            <button class="button ghost" id="tidy" type="button">Tidy</button>
            <button class="button ghost" id="add-space" type="button">Add column</button>
          </GameRoundControls>
          <details class="advanced-features" id="advanced-features">
            <summary>Advanced</summary>
            <div class="advanced-panel">
              {signals && <GameAutofocus />}
              <button class="button ghost" id="replay" type="button" hidden>See the replay</button>
            </div>
          </details>
          <GameReviewControls />
          <p class="message" id="status" role="status"></p>
          <div class="categorical-custom" id="custom-controls" hidden>
            <div class="categorical-actions">
              <label for="difficulty">Difficulty</label>
              <select id="difficulty">
                <option value="1">Easy</option>
                <option value="2" selected>Medium</option>
                <option value="3">Hard</option>
              </select>
              <button class="button ghost" id="new-puzzle" type="button">New puzzle</button>
            </div>
            <div class="categorical-actions">
              <button class="button ghost" id="edit-circuit" type="button" aria-controls="editor-controls">Edit this circuit</button>
              <button class="button ghost" id="new-circuit" type="button" aria-controls="editor-controls">Start from scratch</button>
            </div>
            <GameJsonActions />
          </div>
          <section class="categorical-editor" id="editor-controls" aria-label="Circuit editor" hidden>
            <label class="categorical-expand" hidden={signals}>
              <input type="checkbox" id="reverse-rule" /> Expand
            </label>
            <div class="categorical-dimensions">
              <label for="editor-wires">Wires
                <select id="editor-wires">
                  {[1, 2, 3, 4].map(value => <option value={value} selected={value === 3}>{value}</option>)}
                </select>
              </label>
              <label for="editor-columns">Columns
                <select id="editor-columns">
                  {Array.from({ length: signals ? 16 : 48 }, (_, index) => index + 1).map(value => <option value={value} selected={value === 6}>{value}</option>)}
                </select>
              </label>
            </div>
            <div id="editor-tools" class="categorical-editor-tools" role="group" aria-label="Circuit editing tools">
              {tools.map(tool => (
                <button class="button ghost" type="button" data-editor-tool={tool.value} aria-pressed="false" hidden={tool.value === 'hole' && !signals}>{tool.label}</button>
              ))}
            </div>
            <div id="editor-context" class="categorical-actions" hidden></div>
            <p class="message" id="editor-summary" role="status"></p>
            <div class="categorical-actions">
              {signals && <button class="button ghost" id="capture-target" type="button">Use this output as target</button>}
              <button class="button" id="play-custom" type="button">Play puzzle</button>
            </div>
          </section>
          <noscript>Enable JavaScript to play.</noscript>
        </section>
      </div>
    </div>

    <GameRulesDialog>
      {signals ? (
        <p>Fill the holes to match the target, including relative phases. The paths show amplitudes splitting and combining.</p>
      ) : (
        <p>Reach empty wires: the identity. Select a gate block, then an equation. Include linked endpoints in PROP. In Controlled PROP, select the targets and leave shared controls unselected. Add column makes room; Tidy removes empty columns. Both are free.</p>
      )}
      <p><strong>PRO</strong> is the standard game. <strong>PROP</strong> adds wire crossings. <strong>Controlled PROP</strong> lets you use equations under shared controls.</p>
      {signals ? (
        <p>Editor: place gates, set the output as target, then replace gates with holes. Click neighbouring wires for a swap. Keep controls and targets on different wires.</p>
      ) : (
        <p>Editor: start from empty wires. Enable Expand and apply equations in reverse. Choose shared controls under Control context.</p>
      )}
      <p class="categorical-references">
        Background:
        <a href="https://arxiv.org/abs/2508.21756" target="_blank" rel="noopener noreferrer">Delorme and Perdrix, control as a constructor</a>;
        <a href="https://doi.org/10.4230/LIPIcs.MFCS.2026.6" target="_blank" rel="noopener noreferrer">Blake, polycontrolled PROPs (MFCS 2026)</a>.
      </p>
    </GameRulesDialog>
    <GamePuzzleJsonDialog />
    <GameWinDialog title="Circuit complete" closeLabel="Close result">
      <div class="categorical-actions">
        <button class="button ghost" id="try-again" type="button">Try again</button>
        <button class="button" id="result-next" type="button">Next level</button>
      </div>
    </GameWinDialog>
  </GameShell>
</div>

<script>import '../../scripts/categorical-circuits.js';</script>
