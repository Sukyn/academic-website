<section class="game-tutorial" id="tutorial-panel" aria-labelledby="tutorial-heading" hidden>
  <div aria-live="polite" aria-atomic="true">
    <p id="tutorial-heading"></p>
    <p id="tutorial-text"></p>
  </div>
  <div class="tutorial-actions">
    <button class="button ghost" id="tutorial-start" type="button">Start tutorial</button>
    <button class="button" id="tutorial-next" type="button" hidden>Next step</button>
    <button class="button" id="tutorial-levels" type="button" hidden>Play levels</button>
  </div>
</section>
