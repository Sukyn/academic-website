---
import '../../styles/tutorial-bubble.css';
---

<section class="game-tutorial" id="tutorial-panel" aria-label="Tutorial" hidden>
  <button class="tutorial-close" id="tutorial-close" type="button" aria-label="Exit tutorial" hidden>×</button>
  <div class="tutorial-body">
    <div aria-live="polite" aria-atomic="true">
      <p id="tutorial-heading" hidden></p>
      <p id="tutorial-text" hidden></p>
    </div>
    <div class="tutorial-actions">
      <button class="button ghost" id="tutorial-start" type="button" disabled>Start tutorial</button>
      <button class="button" id="tutorial-next" type="button" hidden>Next step</button>
      <button class="button" id="tutorial-levels" type="button" hidden>Play levels</button>
    </div>
  </div>
</section>
