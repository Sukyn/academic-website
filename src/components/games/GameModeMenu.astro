---
interface Props { daily?: boolean }
const { daily = true } = Astro.props;
---

<nav class="mode-menu" aria-label="Game modes">
  <button class="button ghost" id="mode-tutorial" type="button" aria-pressed="true">Tutorial</button>
  <button class="button ghost" id="mode-campaign" type="button" aria-pressed="false">Levels</button>
  <button class="button ghost" id="mode-random" type="button" aria-pressed="false">Custom/<wbr />Random</button>
  {daily && <div class="daily-menu-group">
    <div class="daily-menu">
      <button class="button ghost" id="mode-daily" type="button" aria-pressed="false">Daily Puzzle</button>
      <button class="button ghost" id="daily-toggle" type="button" aria-label="Past daily puzzles" aria-expanded="false" aria-controls="daily-archive">▾</button>
    </div>
    <div class="daily-archive" id="daily-archive" hidden>
      <label for="daily-date">Past puzzles</label>
      <select id="daily-date" disabled><option value="">Loading…</option></select>
    </div>
  </div>}
  {daily && <p class="message" id="daily-status" role="status"></p>}
  <div class="game-menu-options">
    <slot />
    <button class="button ghost" id="show-rules" type="button" aria-haspopup="dialog">Rules</button>
  </div>
</nav>
