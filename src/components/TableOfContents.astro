---
import katex from "katex";

type Heading = { depth: number; slug: string; text: string };

const { headings = [] } = Astro.props as { headings: Heading[] };
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);

function escapeHtml(s: string) {
  return s
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

/**
 * Render inline LaTeX found in headings into KaTeX HTML for the TOC.
 *
 * Supported:
 *  - $ ... $ (inline)
 *  - \( ... \) (inline)
 *  - $$ ... $$ (we render it inline in TOC on purpose)
 *
 * Everything outside math is HTML-escaped (prevents injection).
 * KaTeX output is restricted to HTML (no MathML) to keep TOC compact.
 */
function renderTocLabel(input: string) {
  if (!input) return "";

  // Normalize \(..\) to $..$ for simpler parsing
  let s = input.replaceAll("\\(", "$").replaceAll("\\)", "$");

  // Convert $$..$$ to $..$ (TOC is always inline)
  s = s.replace(/\$\$([\s\S]+?)\$\$/g, (_m, inner) => `$${inner}$`);

  const parts: string[] = [];

  // Split on $...$ pairs
  while (s.includes("$")) {
    const a = s.indexOf("$");
    const b = s.indexOf("$", a + 1);
    if (b === -1) break;

    // text before math
    const before = s.slice(0, a);
    if (before) parts.push(escapeHtml(before));

    const math = s.slice(a + 1, b).trim();

    // render math
    if (math) {
      const rendered = katex.renderToString(math, {
        throwOnError: false,
        displayMode: false,
        output: "html", // avoids MathML in TOC
        strict: "ignore",
      });
      parts.push(rendered);
    }

    s = s.slice(b + 1);
  }

  // trailing text
  if (s) parts.push(escapeHtml(s));

  return parts.join("");
}
---

{items.length > 0 ? (
  <details class="toc" data-toc open>
    <summary class="toc-summary" aria-label="Table of contents" title="Table of contents">
      Table of contents
    </summary>

    <nav class="toc-nav" aria-label="Table of contents">
      <ol class="toc-list">
        {items.map((h) => (
          <li class={`toc-item depth-${h.depth}`}>
            <a href={`#${h.slug}`} set:html={renderTocLabel(h.text)} />
          </li>
        ))}
      </ol>
    </nav>
  </details>
) : null}


<style>
  details.toc {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .toc-summary {
    cursor: pointer;
    font-weight: 700;
    font-family: var(--font-ui);
  }

  .toc-nav {
    margin-top: 0.75rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0.35rem 0;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
  }

  .toc a {
    text-decoration: none;
    color: var(--color-text);
  }

  .toc a:hover {
    text-decoration: underline;
  }
</style>

