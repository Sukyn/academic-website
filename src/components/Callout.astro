---
export type CalloutType = "note" | "info" | "warning";

export interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = "note", title } = Astro.props;

const icons: Record<CalloutType, string> = {
  note: "📝",
  info: "ℹ️",
  warning: "⚠️",
};
---

<aside class={`callout callout--${type}`} aria-label={type}>
  <div class="callout__header">
    <span class="callout__icon" aria-hidden="true">{icons[type]}</span>
    <strong class="callout__title">{title ?? type.toUpperCase()}</strong>
  </div>
  <div class="callout__body">
    <slot />
  </div>
</aside>
