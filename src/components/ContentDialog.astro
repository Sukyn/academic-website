---
type Props = {
  id: string;
  labelledBy: string;
};

const { id, labelledBy } = Astro.props as Props;
---

<dialog
  id={`${id}-dialog`}
  class="content-dialog"
  aria-labelledby={labelledBy}
>
  <div class="content-dialog__surface">
    <div class="content-dialog__topbar">
      <button
        type="button"
        class="content-dialog__close"
        data-modal-close
        aria-label="Close details"
      >
        Close
      </button>
    </div>

    <div class="content-dialog__content">
      <slot />
    </div>
  </div>
</dialog>

<style>
  .content-dialog {
    width: min(52rem, calc(100% - 2rem));
    max-width: 52rem;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
  }

  .content-dialog::backdrop {
    background: rgba(0, 0, 0, 0.35);
  }

  .content-dialog__surface {
    max-height: 85vh;
    overflow: auto;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
  }

  .content-dialog__topbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1rem;
  }

  .content-dialog__close {
    appearance: none;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface-2);
    color: var(--color-text);
    cursor: pointer;
  }

  .content-dialog__close:hover {
    background: var(--color-surface);
  }

  .content-dialog__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .content-dialog__content {
    position: relative;
  }
</style>
