---
import type { OfferSummary } from "../data/offerSummaries";
import { renderInlineMath } from "../lib/inlineMath";

const { offer } = Astro.props as { offer: OfferSummary };

const fields = [
  { label: "For", value: offer.fit },
  { label: "Background", value: offer.background },
  { label: "Output", value: offer.output },
  { label: "Start", value: offer.firstMilestone },
];
---

<section class="offer-snapshot" aria-label="At a glance">
  {fields.map(({ label, value }) => (
    <div class="offer-snapshot-item">
      <p class="offer-snapshot-label">{label}</p>
      <p set:html={renderInlineMath(value)} />
    </div>
  ))}
</section>

<style>
  .offer-snapshot {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .offer-snapshot-item p {
    margin: 0;
  }

  .offer-snapshot-label {
    margin-bottom: 0.2rem !important;
    font-size: 0.9rem;
    font-weight: 700;
    font-family: var(--font-ui);
    color: var(--color-muted);
  }

  @media (min-width: 760px) {
    .offer-snapshot {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
