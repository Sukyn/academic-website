---
type Props = {
  id: string;
  labelledBy: string;
};

const { id, labelledBy } = Astro.props as Props;
---

<dialog
  id={`${id}-dialog`}
  class="offer-modal"
  data-offer-modal={id}
  aria-labelledby={labelledBy}
>
  <div class="offer-modal__surface">
    <div class="offer-modal__topbar">
      <button
        type="button"
        class="offer-modal__close"
        data-offer-modal-close
        aria-label="Close details"
      >
        <span class="offer-modal__close-icon" aria-hidden="true"></span>
      </button>
    </div>

    <div class="offer-modal__content">
      <slot />
    </div>
  </div>
</dialog>

<style>
  .offer-modal {
    width: min(74rem, calc(100% - 2rem));
    max-width: 74rem;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
  }

  .offer-modal::backdrop {
    background: rgba(16, 32, 58, 0.52);
    backdrop-filter: blur(6px);
  }

  .offer-modal__surface {
    position: relative;
    max-height: min(88vh, 64rem);
    overflow: auto;
    padding: 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--color-bg) 96%, var(--color-border) 4%);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
  }

  .offer-modal__surface::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--color-accent) 75%, white 25%),
      color-mix(in oklab, var(--color-accent) 35%, transparent 65%)
    );
    pointer-events: none;
  }

  .offer-modal__topbar {
    position: sticky;
    top: -1.3rem;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    margin: -1.3rem -1.3rem 1rem;
    padding: 0.85rem 0.95rem 0.75rem;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-bg) 97%, var(--color-border) 3%),
      color-mix(in oklab, var(--color-bg) 92%, transparent 8%)
    );
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 82%, transparent 18%);
  }

  .offer-modal__close {
    appearance: none;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid color-mix(in oklab, var(--color-border) 62%, var(--color-accent) 38%);
    border-radius: 0.8rem;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-bg) 93%, var(--color-accent) 7%),
      color-mix(in oklab, var(--color-bg) 98%, var(--color-border) 2%)
    );
    color: var(--color-text);
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    transition:
      transform 120ms ease,
      border-color 120ms ease,
      box-shadow 120ms ease,
      background 120ms ease;
  }

  .offer-modal__close:hover {
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--color-accent) 58%, var(--color-border) 42%);
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-bg) 88%, var(--color-accent) 12%),
      color-mix(in oklab, var(--color-bg) 95%, var(--color-border) 5%)
    );
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
  }

  .offer-modal__close:active {
    transform: translateY(0);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1);
  }

  .offer-modal__close:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .offer-modal__close-icon {
    position: relative;
    display: block;
    width: 0.95rem;
    height: 0.95rem;
  }

  .offer-modal__close-icon::before,
  .offer-modal__close-icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.95rem;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
  }

  .offer-modal__close-icon::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .offer-modal__close-icon::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .offer-modal__content {
    position: relative;
  }

  @media (prefers-reduced-motion: reduce) {
    .offer-modal__close {
      transition: none;
    }
  }
</style>
