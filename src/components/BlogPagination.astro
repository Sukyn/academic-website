---
import { getBlogPageHref } from "../lib/posts";

type Props = {
  currentPage: number;
  pageCount: number;
};

const { currentPage, pageCount } = Astro.props as Props;
const previousHref =
  currentPage > 1 ? getBlogPageHref(currentPage - 1) : undefined;
const nextHref =
  currentPage < pageCount ? getBlogPageHref(currentPage + 1) : undefined;
---

{pageCount > 1 ? (
  <>
    <nav class="pagination" aria-label="Blog pagination">
      {previousHref ? <a href={previousHref}>&larr; Previous</a> : <span />}

      <span class="muted">Page {currentPage} of {pageCount}</span>

      {nextHref ? <a href={nextHref}>Next &rarr;</a> : <span />}
    </nav>

    <style>
      .pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }

      .pagination a {
        text-decoration: none;
      }

      .pagination a:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }
    </style>
  </>
) : null}
