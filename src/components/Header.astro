---
import { siteProfile } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/about", label: "About" },
  { href: "/publications", label: "Publications" },
  { href: "/contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand-block">
      <a class="brand" href="/" aria-label={`${siteProfile.name} home page`}>
        {siteProfile.name}
      </a>
      <p class="site-subtitle">{siteProfile.affiliation}</p>
    </div>

    <nav class="site-nav" aria-label="Main navigation">
      {nav.map(({ href, label }) => (
        <a href={href} aria-current={pathname === href ? "page" : undefined}>
          {label}
        </a>
      ))}
    </nav>
  </div>

  <style>
    .site-header {
      padding-block: 1.15rem 0.95rem;
      border-bottom: 1px solid var(--color-border-strong);
      background: linear-gradient(180deg, rgba(27, 40, 34, 0.94), rgba(24, 35, 30, 0.76));
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem 1.5rem;
      flex-wrap: wrap;
    }

    .brand-block {
      min-width: 0;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      font-size: 1.72rem;
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1;
      color: var(--color-heading);
      text-shadow: 0 0 18px rgba(154, 217, 209, 0.12);
      text-decoration: none;
    }

    .site-subtitle {
      margin: 0.2rem 0 0;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .site-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem 1rem;
      align-items: center;
      padding-top: 0.35rem;
      font-family: var(--font-ui);
      font-size: 0.95rem;
    }

    .site-nav a {
      color: var(--color-text);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      padding-bottom: 0.15rem;
    }

    .site-nav a:hover {
      color: var(--color-accent-hover);
      border-bottom-color: rgba(154, 217, 209, 0.32);
    }

    .site-nav a[aria-current="page"] {
      font-weight: 600;
      color: var(--color-accent);
      border-bottom-color: var(--color-accent);
    }

    @media (max-width: 520px) {
      .brand {
        font-size: 1.55rem;
      }
    }
  </style>
</header>