---
import { siteProfile } from "../data/site";

const rawPath = Astro.url.pathname || "/";
const pathname = rawPath !== "/" ? rawPath.replace(/\/$/, "") : "/";

const nav = [
  { href: "/about", label: "About" },
  { href: "/publications", label: "Publications" },
  { href: "/blog", label: "Blog" },
  { href: "/offers", label: "Research ideas" },
  { href: "/contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand-block">
      <a class="brand" href="/" aria-label="Colin Blake home page">Colin Blake</a>
      <p class="site-subtitle">{siteProfile.affiliation}</p>
    </div>

    <nav class="site-nav" aria-label="Main navigation">
      {nav.map(({ href, label }) => (
        <a href={href} aria-current={pathname === href ? "page" : undefined}>
          {label}
        </a>
      ))}
    </nav>
  </div>

  <style>
    .site-header {
      padding-block: 1rem 0.8rem;
      border-bottom: 1px solid var(--color-border-strong);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem 1.5rem;
      flex-wrap: wrap;
    }

    .brand-block {
      min-width: 0;
    }

    .brand {
      display: inline-block;
      font-size: 1.45rem;
      font-weight: 700;
      color: var(--color-text);
      text-decoration: none;
    }

    .site-subtitle {
      margin: 0.2rem 0 0;
      color: var(--color-muted);
      font-family: var(--font-ui);
      font-size: 0.95rem;
    }

    .site-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 1rem;
      align-items: center;
      padding-top: 0.35rem;
      font-family: var(--font-ui);
    }

    .site-nav a {
      color: var(--color-text);
      text-decoration: none;
    }

    .site-nav a:hover {
      text-decoration: underline;
    }

    .site-nav a[aria-current="page"] {
      font-weight: 700;
      text-decoration: underline;
    }
  </style>
</header>
