---
import type { CollectionEntry } from "astro:content";
import { formatDate, readingTimeFromText } from "../lib/format";

type Props = {
  posts: CollectionEntry<"posts">[];
  showDescriptions?: boolean;
};

const { posts, showDescriptions = true } = Astro.props as Props;
---

<ol class="post-list" aria-label="Posts">
  {posts.map((post) => (
    <li class="post-item">
      <a class="post-link" href={`/blog/${post.id}/`}>{post.data.title}</a>

      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>

        <span class="reading-time">{readingTimeFromText(post.body)}</span>

        {(post.data.tags?.length ?? 0) > 0 ? (
          <span class="tags" aria-label="Tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))}
          </span>
        ) : null}

        {post.data.draft ? <span class="pill draft">Draft</span> : null}
      </div>

      {showDescriptions && post.data.description ? (
        <p class="muted">{post.data.description}</p>
      ) : null}
    </li>
  ))}
</ol>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }

  .post-item {
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }

  .post-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  .post-link {
    text-decoration: none;
    font-weight: 750;
  }

  .post-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .tags {
    display: inline-flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
</style>
