---
import {
  profileLinks,
  siteProfile,
} from "../data/site";

const year = new Date().getFullYear();
const fish = [
  {
    delay: "-1.8s",
    depth: "0.8rem",
    speed: "18s",
    scale: "0.9",
    color: "#f7f5eb",
    shine: "#ffffff",
    eye: "#050706",
    shadow: "rgba(0, 0, 0, 0.42)",
  },
  {
    delay: "-7.2s",
    depth: "1.75rem",
    speed: "24s",
    scale: "0.72",
    color: "#050706",
    shine: "#111611",
    eye: "#f7f5eb",
    shadow: "rgba(247, 245, 235, 0.5)",
    reverse: true,
  },
  {
    delay: "-11s",
    depth: "1.15rem",
    speed: "21s",
    scale: "0.82",
    color: "#050706",
    shine: "#111611",
    eye: "#f7f5eb",
    shadow: "rgba(247, 245, 235, 0.5)",
  },
  {
    delay: "-14.5s",
    depth: "2.25rem",
    speed: "28s",
    scale: "0.64",
    color: "#f7f5eb",
    shine: "#ffffff",
    eye: "#050706",
    shadow: "rgba(0, 0, 0, 0.42)",
    reverse: true,
  },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">&copy; {year} {siteProfile.name}</p>

    <ul class="footer-links">
      <li>
        <a href="/publications">Publications</a>
      </li>

      {profileLinks.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="footer-ocean" aria-hidden="true">
    {fish.map((item) => (
      <span
        class={`ocean-fish${item.reverse ? " ocean-fish--reverse" : ""}`}
        style={`--delay: ${item.delay}; --depth: ${item.depth}; --speed: ${item.speed}; --scale: ${item.scale}; --fish-color: ${item.color}; --fish-shine: ${item.shine}; --fish-eye: ${item.eye}; --fish-shadow: ${item.shadow};`}
      >
        <span class="ocean-fish__tail"></span>
        <span class="ocean-fish__body"></span>
      </span>
    ))}
  </div>

  <style>
    .site-footer {
      position: relative;
      overflow: hidden;
      border-top: 1px solid var(--color-border-strong);
      padding-block: 1.75rem 3.45rem;
      background:
        linear-gradient(180deg, transparent, rgba(154, 217, 209, 0.07)) bottom / 100% 3.8rem no-repeat,
        linear-gradient(180deg, transparent 36%, rgba(24, 35, 30, 0.86)),
        linear-gradient(180deg, transparent 64%, rgba(27, 40, 34, 0.36));
    }

    .footer-inner {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: start;
      justify-content: space-between;
      gap: 0.75rem 1.5rem;
      flex-wrap: wrap;
    }

    .footer-copy {
      margin: 0;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 1rem;
      font-family: var(--font-ui);
      font-size: 0.95rem;
    }

    .footer-links a {
      color: var(--color-text);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      padding-bottom: 0.15rem;
    }

    .footer-links a:hover {
      color: var(--color-accent-hover);
      border-bottom-color: rgba(154, 217, 209, 0.32);
    }

    .footer-ocean {
      position: absolute;
      z-index: 1;
      inset-inline: 0;
      bottom: 0;
      height: 3.3rem;
      overflow: hidden;
      pointer-events: none;
      image-rendering: pixelated;
      background:
        linear-gradient(90deg, rgba(255, 243, 207, 0.09) 0 4px, transparent 4px 20px) bottom / 56px 0.55rem repeat-x,
        linear-gradient(90deg, rgba(13, 20, 17, 0.34) 0 18px, rgba(33, 48, 41, 0.28) 18px 36px) bottom / 88px 0.55rem repeat-x,
        linear-gradient(180deg, rgba(154, 217, 209, 0.11), transparent 34%),
        linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface-2) 54%, var(--color-code-block) 100%);
    }

    .footer-ocean::before,
    .footer-ocean::after {
      content: "";
      position: absolute;
      z-index: 1;
      inset-inline: -3rem;
      display: block;
      height: 0.95rem;
      background-repeat: repeat-x;
      animation: ocean-wave-shift var(--wave-speed) linear infinite;
    }

    .footer-ocean::before {
      --wave-speed: 8200ms;
      top: 0.35rem;
      opacity: 0.34;
      background-size: 80px 100%;
      background-image: linear-gradient(
        90deg,
        transparent 0 12px,
        rgba(154, 217, 209, 0.26) 12px 16px,
        rgba(66, 80, 70, 0.36) 16px 32px,
        transparent 32px 46px,
        rgba(200, 244, 239, 0.18) 46px 58px,
        transparent 58px 80px
      );
    }

    .footer-ocean::after {
      --wave-speed: 11600ms;
      top: 1.05rem;
      opacity: 0.46;
      background-size: 96px 100%;
      background-image: linear-gradient(
        90deg,
        rgba(16, 33, 28, 0.38) 0 12px,
        rgba(255, 243, 207, 0.2) 12px 16px,
        rgba(109, 123, 113, 0.34) 16px 40px,
        transparent 40px 56px,
        rgba(154, 217, 209, 0.22) 56px 72px,
        transparent 72px 96px
      );
      animation-direction: reverse;
    }

    .ocean-fish {
      --flip: scaleX(1);
      --start-x: -4rem;
      --middle-x: 50vw;
      --middle-y: -0.14rem;
      --end-x: calc(100vw + 5rem);
      --end-y: 0.1rem;
      position: absolute;
      z-index: 2;
      left: -4rem;
      bottom: var(--depth);
      width: 36px;
      height: 20px;
      opacity: 0.9;
      filter: drop-shadow(0 0 1px var(--fish-shadow));
      transform: translateX(var(--start-x)) var(--flip) scale(var(--scale));
      transform-origin: center;
      animation: ocean-fish-swim var(--speed) linear infinite;
      animation-delay: var(--delay);
    }

    .ocean-fish--reverse {
      --flip: scaleX(-1);
      --start-x: 4rem;
      --middle-x: -50vw;
      --middle-y: 0.12rem;
      --end-x: calc(-100vw - 5rem);
      --end-y: -0.08rem;
      left: auto;
      right: -4rem;
    }

    .ocean-fish__body,
    .ocean-fish__tail {
      position: absolute;
      width: 4px;
      height: 4px;
      background: var(--fish-color);
    }

    .ocean-fish__body {
      left: 12px;
      top: 4px;
      box-shadow:
        4px 0 var(--fish-color),
        8px 0 var(--fish-shine),
        12px 0 var(--fish-color),
        16px 0 var(--fish-eye),
        0 4px var(--fish-color),
        4px 4px var(--fish-color),
        8px 4px var(--fish-color),
        12px 4px var(--fish-shine),
        16px 4px var(--fish-color),
        4px 8px var(--fish-color),
        8px 8px var(--fish-color),
        12px 8px var(--fish-color);
    }

    .ocean-fish__tail {
      left: 4px;
      top: 8px;
      box-shadow:
        -4px -4px var(--fish-color),
        -4px 4px var(--fish-color);
      animation: ocean-tail-flick 520ms steps(2, end) infinite;
    }

    @keyframes ocean-wave-shift {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(96px);
      }
    }

    @keyframes ocean-fish-swim {
      0% {
        opacity: 0;
        transform: translateX(var(--start-x)) translateY(0) var(--flip) scale(var(--scale));
      }

      8%, 92% {
        opacity: 0.9;
      }

      45% {
        transform: translateX(var(--middle-x)) translateY(var(--middle-y)) var(--flip) scale(var(--scale));
      }

      100% {
        opacity: 0;
        transform: translateX(var(--end-x)) translateY(var(--end-y)) var(--flip) scale(var(--scale));
      }
    }

    @keyframes ocean-tail-flick {
      0%, 100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-2px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .footer-ocean::before,
      .footer-ocean::after,
      .ocean-fish,
      .ocean-fish__tail {
        animation: none;
      }

      .ocean-fish {
        display: none;
      }
    }
  </style>
</footer>