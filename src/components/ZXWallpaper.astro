<canvas id="zx-wallpaper" aria-hidden="true"></canvas>

<style>
  #zx-wallpaper {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.12; /* ~10% transparency */
  }
</style>

<script is:inline>
  (() => {
    const el = document.getElementById("zx-wallpaper");
    if (!(el instanceof HTMLCanvasElement)) return;
    const canvas = el;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const rand = (a, b) => a + Math.random() * (b - a);
    const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];

    const TYPES = ["G", "R", "Y"];

    /** @type {Array<{x:number,y:number,vx:number,vy:number,type:"G"|"R"|"Y",r:number}>} */
    const nodes = [];
    /** @type {Array<{a:number,b:number,curve:number}>} */
    const edges = [];

    const FPS = 30;
    const FRAME_MS = 1000 / FPS;

    // Respect accessibility preference
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let cssW = window.innerWidth;
    let cssH = window.innerHeight;

    function getEdgeColor() {
      const isDark = document.documentElement.dataset.theme === "dark";
      return isDark ? "rgba(255, 255, 255, 0.35)" : "rgba(15, 23, 42, 0.35)";
    }

    function resize() {
      const dpr = Math.min(1.5, window.devicePixelRatio || 1);
      cssW = window.innerWidth;
      cssH = window.innerHeight;

      canvas.width = Math.floor(cssW * dpr);
      canvas.height = Math.floor(cssH * dpr);
      canvas.style.width = "100%";
      canvas.style.height = "100%";

      // draw in CSS pixels
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function init() {
      nodes.length = 0;
      edges.length = 0;

      const isSmall = Math.min(cssW, cssH) < 700;
      const NODE_COUNT = isSmall ? 18 : 26;
      const EDGE_COUNT = isSmall ? 24 : 34;

      for (let i = 0; i < NODE_COUNT; i++) {
        const type = /** @type {"G"|"R"|"Y"} */ (pick(TYPES));
        nodes.push({
          x: rand(0, cssW),
          y: rand(0, cssH),
          // VERY slow drift
          vx: rand(-4, 4) / 60,
          vy: rand(-4, 4) / 60,
          type,
          r: type === "Y" ? rand(8, 12) : rand(7, 11),
        });
      }

      for (let i = 0; i < EDGE_COUNT; i++) {
        const a = Math.floor(rand(0, NODE_COUNT));
        let b = Math.floor(rand(0, NODE_COUNT));
        if (b === a) b = (b + 1) % NODE_COUNT;

        edges.push({
          a,
          b,
          // curve controls how “bendy” the edge is
          curve: rand(-120, 120),
        });
      }
    }

    function wrap(n) {
      // wrap-around
      if (n.x < -40) n.x = cssW + 40;
      if (n.x > cssW + 40) n.x = -40;
      if (n.y < -40) n.y = cssH + 40;
      if (n.y > cssH + 40) n.y = -40;
    }

    function drawEdge(e) {
      const A = nodes[e.a];
      const B = nodes[e.b];
      if (!A || !B) return;

      const mx = (A.x + B.x) / 2;
      const my = (A.y + B.y) / 2;

      // normal vector for curved control point
      const dx = B.x - A.x;
      const dy = B.y - A.y;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;

      const cx = mx + nx * e.curve;
      const cy = my + ny * e.curve;

      ctx.lineWidth = 1.2;
      ctx.strokeStyle = getEdgeColor();

      ctx.beginPath();
      ctx.moveTo(A.x, A.y);
      ctx.quadraticCurveTo(cx, cy, B.x, B.y);
      ctx.stroke();
    }

    function drawNode(n) {
      if (n.type === "Y") {
        // Yellow square node
        ctx.fillStyle = "rgba(234, 179, 8, 0.95)";
        const s = n.r * 2;
        ctx.beginPath();
        ctx.rect(n.x - s / 2, n.y - s / 2, s, s);
        ctx.fill();
        return;
      }

      // Green / Red circle nodes
      ctx.fillStyle =
        n.type === "G" ? "rgba(34, 197, 94, 0.95)" : "rgba(239, 68, 68, 0.95)";
      ctx.strokeStyle = "rgba(15, 23, 42, 0.18)";
      ctx.lineWidth = 1;

      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
    }

    function step(dt) {
      for (const n of nodes) {
        n.x += n.vx * (dt * 60);
        n.y += n.vy * (dt * 60);

        // tiny random wander to avoid “too linear”
        n.vx += rand(-0.02, 0.02) * dt;
        n.vy += rand(-0.02, 0.02) * dt;

        // clamp speed
        n.vx = Math.max(-0.12, Math.min(0.12, n.vx));
        n.vy = Math.max(-0.12, Math.min(0.12, n.vy));

        wrap(n);
      }
    }

    function draw() {
      ctx.clearRect(0, 0, cssW, cssH);

      // Draw edges first, then nodes
      for (const e of edges) drawEdge(e);
      for (const n of nodes) drawNode(n);
    }

    function shouldRun() {
      return !reduceMotion.matches && !document.hidden;
    }

    let raf = 0;
    let last = 0;
    let accMs = 0;

    function loop(now) {
      if (!shouldRun()) {
        raf = 0;
        return;
      }

      if (!last) last = now;
      const delta = now - last;
      last = now;
      accMs += delta;

      // throttle to ~FPS
      while (accMs >= FRAME_MS) {
        step(Math.min(0.05, FRAME_MS / 1000));
        accMs -= FRAME_MS;
      }

      draw();
      raf = requestAnimationFrame(loop);
    }

    function startLoop() {
      if (raf || !shouldRun()) return;
      last = 0;
      accMs = 0;
      raf = requestAnimationFrame(loop);
    }

    function stopLoop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    function startWhenIdle() {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(() => startLoop(), { timeout: 250 });
        return;
      }

      window.setTimeout(startLoop, 120);
    }

    // Init once
    resize();
    init();
    draw();
    startWhenIdle();

    window.addEventListener("resize", () => {
      resize();
      init();
      draw();
    });

    const updateRunning = () => {
      stopLoop();
      // Keep a static frame visible even when stopped
      draw();
      startLoop();
    };

    if (reduceMotion.addEventListener) reduceMotion.addEventListener("change", updateRunning);
    else reduceMotion.addListener(updateRunning);

    document.addEventListener("visibilitychange", updateRunning);
  })();
</script>
