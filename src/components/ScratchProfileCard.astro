---
interface Props {
  src?: string;
  alt?: string;
  sources?: string[];
}

const {
  src = "/images/profile/colin-blake-portrait.jpg",
  alt = "Stylized profile picture of Colin Blake",
  sources,
} = Astro.props;

const imageSources = Array.from(
  new Set(
    sources?.length ? sources : [
      src,
      "/images/profile/colin-blake-portrait-2.jpg",
      "/images/profile/colin-blake-portrait-3.jpg",
      "/images/profile/colin-blake-portrait-4.jpg",
      "/images/profile/colin-blake-portrait-5.png",
    ],
  ),
);
---

<section
  class="scratch-profile"
  data-scratch-profile
  data-scratch-sources={JSON.stringify(imageSources)}
>
  <div class="scratch-ticket">
    <div class="scratch-window">
      <img
        src={imageSources[0]}
        alt={alt}
        width="240"
        height="240"
        loading="eager"
        decoding="async"
      />
      <canvas class="scratch-cover" data-scratch-canvas aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<script>import "../scripts/scratch-profile.js";</script>

<style>
  .scratch-profile {
    justify-self: center;
    width: min(100%, 11rem);
  }

  .scratch-ticket {
    width: 100%;
  }

  .scratch-window {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.9rem;
    background: #a7adb7;
  }

  .scratch-window img,
  .scratch-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scratch-window img {
    display: block;
    object-fit: cover;
    object-position: center 18%;
    image-rendering: crisp-edges;
  }

  .scratch-cover {
    display: none;
    cursor: grab;
    touch-action: none;
  }

  .scratch-cover:active {
    cursor: grabbing;
  }

  .scratch-profile[data-ready="true"] .scratch-cover {
    display: block;
  }

  .scratch-profile[data-revealed="true"] .scratch-cover {
    opacity: 0;
    transition: opacity 180ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .scratch-profile[data-revealed="true"] .scratch-cover {
      transition: none;
    }
  }
</style>
