---
import type { OfferSummary } from "../data/offerSummaries";

const { offer } = Astro.props as { offer: OfferSummary };
---

<button
  class="offer-preview-card"
  type="button"
  data-offer-modal-trigger={offer.id}
  aria-haspopup="dialog"
  aria-controls={`${offer.id}-dialog`}
>
  <div class="offer-preview-meta">
    <span class={`pill ${offer.statusClass}`}>{offer.status}</span>
    <span class="pill">{offer.fitBadge}</span>
  </div>

  <h4>{offer.title}</h4>

  <p>
    <strong>Background:</strong> {offer.background}
  </p>

  <p class="offer-preview-foot">
    <strong>First milestone:</strong> {offer.firstMilestone}
  </p>
</button>

<style>
  .offer-preview-card {
    appearance: none;
    display: block;
    width: 100%;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .offer-preview-card:hover {
    background: var(--color-surface);
  }

  .offer-preview-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .offer-preview-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .offer-preview-card h4 {
    margin: 0 0 0.55rem;
    color: var(--color-text);
    font-size: 1rem;
  }

  .offer-preview-card p {
    margin: 0;
    color: var(--color-muted);
  }

  .offer-preview-foot {
    margin-top: 0.6rem !important;
  }
</style>
