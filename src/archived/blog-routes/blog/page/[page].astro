---
import BlogArchiveList from "../../../components/BlogArchiveList.astro";
import BlogPagination from "../../../components/BlogPagination.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  POSTS_PER_PAGE,
  getPageCount,
  getPostsForPage,
  getVisiblePosts,
} from "../../../lib/posts";

export async function getStaticPaths() {
  const allPosts = await getVisiblePosts();
  const pageCount = getPageCount(allPosts.length, POSTS_PER_PAGE);

  if (pageCount <= 1) return [];

  return Array.from({ length: pageCount - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const allPosts = await getVisiblePosts();
const currentPage = Number(Astro.params.page);
const posts = getPostsForPage(allPosts, currentPage, POSTS_PER_PAGE);
const pageCount = getPageCount(allPosts.length, POSTS_PER_PAGE);
---

<BaseLayout
  title={`Blog - Page ${currentPage}`}
  description={`Older blog posts from Colin Blake's archive, page ${currentPage}.`}
>
  <section class="prose">
    <p class="muted"><a href="/blog">&larr; Back to the main blog page</a></p>
    <h1>Blog archive</h1>
    <BlogArchiveList posts={posts} />
    <BlogPagination currentPage={currentPage} pageCount={pageCount} />
  </section>
</BaseLayout>
