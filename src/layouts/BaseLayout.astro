---
import ZXWallpaper from "../components/ZXWallpaper.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteProfile } from "../data/site";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  wallpaper?: boolean;
}

const {
  title,
  description = "Quantum computing research, publications, and collaboration ideas by Colin Blake.",
  noindex = false,
  wallpaper = true,
} = Astro.props;

const siteName = siteProfile.name;
const pageTitle = title === "Home" ? siteName : `${title} | ${siteName}`;
const canonical = Astro.url.toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" href="/fonts/grenze-gotisch-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spectral-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/alegreya-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {wallpaper && <ZXWallpaper />}
    <div class="page">
      <Header />
      <main id="main-content" class="container" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
