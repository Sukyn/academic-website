---
import { Font } from "astro:assets";
import ZXWallpaper from "../components/ZXWallpaper.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteProfile } from "../data/site";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Quantum computing research, publications, and collaboration ideas by Colin Blake.",
  noindex = false,
} = Astro.props;

const siteName = siteProfile.name;
const pageTitle = title === "Home" ? siteName : `${title} | ${siteName}`;
const canonical = Astro.url.toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Font
      cssVariable="--font-display"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <Font
      cssVariable="--font-body"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font
      cssVariable="--font-ui"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font
      cssVariable="--font-mono"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <ZXWallpaper />
    <div class="page">
      <Header />
      <main id="main-content" class="container">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
