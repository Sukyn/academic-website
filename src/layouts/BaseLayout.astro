---
import ZXWallpaper from "../components/ZXWallpaper.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  includeKatex?: boolean;
  showWallpaper?: boolean;

  /** Absolute or site-relative (recommended: "/og/default.png") */
  ogImage?: string;

  /** Override if needed; otherwise we use Astro.url */
  canonicalUrl?: URL | string;
}

const {
  title,
  description = "Quantum computing research, publications, and collaboration ideas by Colin Blake.",
  includeKatex = false,
  showWallpaper = true,
  ogImage,
  canonicalUrl,
} = Astro.props;

const siteName = "Colin Blake";
const pageTitle =
  title === "Home" || title === siteName ? siteName : `${title} | ${siteName}`;

// Canonical URL (good for SEO + sharing)
const canonical =
  typeof canonicalUrl === "string"
    ? canonicalUrl
    : canonicalUrl instanceof URL
      ? canonicalUrl.toString()
      : Astro.url.toString();

// Resolve OG image to an absolute URL if Astro.site exists
const resolvedOgImage = (() => {
  if (!ogImage) return undefined;
  try {
    // If ogImage is already absolute, URL() will keep it.
    // If it's "/something.png", it becomes absolute using Astro.site.
    const base = Astro.site ?? new URL(canonical);
    return new URL(ogImage, base).toString();
  } catch {
    return undefined;
  }
})();

// Cloudflare Web Analytics (prod-only)
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=STIX+Two+Text:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {resolvedOgImage ? <meta property="og:image" content={resolvedOgImage} /> : null}

    <!-- Twitter card (works for many platforms too) -->
    <meta
      name="twitter:card"
      content={resolvedOgImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage ? <meta name="twitter:image" content={resolvedOgImage} /> : null}

    {includeKatex ? (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.27/dist/katex.min.css"
      />
    ) : null}

    <!-- Cloudflare Web Analytics (prod-only) -->
    {isProd && cfToken ? (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfToken, spa: true })}
      />
    ) : null}
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showWallpaper ? <ZXWallpaper /> : null}
    <div class="page">
      <Header />
      <main id="main-content" class="container">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
