---
import ZXWallpaper from "../components/ZXWallpaper.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteProfile } from "../data/site";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  includeKatex?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = "Quantum computing research, publications, and collaboration ideas by Colin Blake.",
  includeKatex = false,
  noindex = false,
} = Astro.props;

const siteName = siteProfile.name;
const pageTitle = title === "Home" ? siteName : `${title} | ${siteName}`;
const canonical = Astro.url.toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Grenze+Gotisch:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {includeKatex ? (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.27/dist/katex.min.css"
      />
    ) : null}

  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <ZXWallpaper />
    <div class="page">
      <Header />
      <main id="main-content" class="container">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
