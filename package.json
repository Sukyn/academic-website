{
  "name": "academic-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs tests/quantum-golf/*.test.mjs",
    "test:circuits": "node --test tests/circuits.test.mjs",
    "test:golf": "node --test tests/quantum-golf/*.test.mjs",
    "test:golf:api": "node --test tests/quantum-golf/vercel-leaderboard.test.mjs",
    "precompute:golf": "node tools/quantum-golf/python.mjs tools/quantum-golf/precompute.py",
    "verify:campaign": "node tools/quantum-golf/python.mjs tools/quantum-golf/precompute.py --check",
    "check:golf": "node tools/quantum-golf/check.mjs",
    "golf:export": "node tools/quantum-golf/export.mjs",
    "golf:migrate": "node tools/quantum-golf/migrate.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@neondatabase/serverless": "1.2.0",
    "astro": "7.3.8",
    "bibtex-parse-js": "0.0.23",
    "gifenc": "1.0.3",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@electric-sql/pglite": "0.5.9",
    "typescript": "5.9.3"
  }
}
